---
import {pretty,words} from '../lib/data';
const {section, collapsible = false} = Astro.props;
const paragraphs=Array.isArray(section.body)?section.body:section.body?[section.body]:[];
const rows=section.rows||[];
const headings=section.headings||section.columns||(rows.length&&typeof rows[0]==='object'&&!Array.isArray(rows[0])?Object.keys(rows[0]):[]);
const Container = collapsible ? 'details' : 'section';
function cell(v:any){if(v===null||v===undefined)return '';if(Array.isArray(v))return v.map(x=>pretty(x)||JSON.stringify(x)).join(', ');if(typeof v==='object')return pretty(v)||Object.entries(v).map(([k,x])=>`${words(k)}: ${x}`).join(', ');return String(v);}
---
<Container class={collapsible ? 'mechanic-disclosure' : 'section'}>
  {collapsible ? <summary>{section.title}</summary> : <h3>{section.title}</h3>}
  <div class="mechanic-disclosure-body">
    {paragraphs.map((p:any) => <p>{typeof p === 'string' ? p : pretty(p)}</p>)}
    {rows.length > 0 && <div class="table-wrap"><table>
      {headings.length > 0 && <thead><tr>{headings.map((h:string) => <th scope="col">{words(h)}</th>)}</tr></thead>}
      <tbody>{rows.map((row:any) => <tr>{(Array.isArray(row) ? row : typeof row === 'object' ? headings.map((k:string) => row[k]) : [row]).map((v:any) => <td>{cell(v)}</td>)}</tr>)}</tbody>
    </table></div>}
  </div>
</Container>

<style>
  .mechanic-disclosure {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    min-width: 0;
  }
  .mechanic-disclosure summary {
    cursor: pointer;
    padding: 13px 16px;
    font-weight: 550;
  }
  .mechanic-disclosure summary::marker {
    color: var(--gold-text);
  }
  .mechanic-disclosure[open] summary {
    border-bottom: 1px solid var(--border-soft);
  }
  .mechanic-disclosure-body {
    min-width: 0;
  }
  .mechanic-disclosure .mechanic-disclosure-body {
    color: var(--muted);
    padding: 14px 16px 16px;
  }
  .mechanic-disclosure-body p:last-child {
    margin-bottom: 0;
  }
  .mechanic-disclosure-body .table-wrap {
    margin-top: 12px;
  }
</style>
