---
import { href } from '../lib/data';
import screenshotRecords from '../data/screenshot-gallery.json';
import Icon from './Icon.astro';

const screenshots = screenshotRecords.map(({ file, ...details }) => ({
  ...details,
  src: href(`media/screenshots/${file}`),
}));
const first = screenshots[0];
const hasMultiple = screenshots.length > 1;
const arrows = [
  { side: 'left', step: -1, label: 'Previous screenshot' },
  { side: 'right', step: 1, label: 'Next screenshot' },
];
---
<section class="gallery" aria-labelledby="screenshots" data-screenshot-gallery={JSON.stringify(screenshots)}>
  <h2 id="screenshots">Screenshots</h2>
  <figure class="gallery-frame gallery-preview">
    <a class="gallery-link" href={first.src} data-gallery-open aria-label="Enlarge screenshot">
      <img src={first.src} alt={first.alt} width={first.width} height={first.height} decoding="async" data-gallery-image />
      <img class="gallery-brand" src={href('media/screenshots/tnk3-brand.png')} alt="" width="216" height="87" decoding="async" />
      <span class="gallery-enlarge"><Icon name="expand" size={18} /></span>
    </a>
    {hasMultiple && arrows.map(({ side, step, label }) => (
      <button class={`gallery-arrow gallery-arrow-${side}`} type="button" aria-label={label} data-gallery-step={step}>
        <Icon name={`chevron-${side}`} size={23} />
      </button>
    ))}
  </figure>

  <dialog class="gallery-dialog" aria-labelledby="screenshot-dialog-title">
    <div class="gallery-dialog-header">
      <h2 id="screenshot-dialog-title" data-gallery-title aria-live="polite">{first.title}</h2>
      <form method="dialog"><button type="submit" autofocus>Close</button></form>
    </div>
    <div class="gallery-frame">
      <img src={first.src} alt={first.alt} width={first.width} height={first.height} loading="lazy" data-gallery-image />
      {hasMultiple && arrows.map(({ side, step, label }) => (
        <button class={`gallery-arrow gallery-arrow-${side}`} type="button" aria-label={label} data-gallery-step={step}>
          <Icon name={`chevron-${side}`} size={23} />
        </button>
      ))}
    </div>
  </dialog>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-screenshot-gallery]');
  const frame = gallery?.querySelector<HTMLElement>('.gallery-preview');
  const preview = gallery?.querySelector<HTMLAnchorElement>('[data-gallery-open]');
  const dialog = gallery?.querySelector<HTMLDialogElement>('dialog');

  if (gallery && frame && preview && dialog) {
    type Screenshot = { src: string; title: string; alt: string; width: number; height: number };
    const screenshots: Screenshot[] = JSON.parse(gallery.dataset.screenshotGallery ?? '[]');
    const images = gallery.querySelectorAll<HTMLImageElement>('[data-gallery-image]');
    const titles = gallery.querySelectorAll('[data-gallery-title]');
    let current = 0;

    function step(change: number) {
      current = (current + change + screenshots.length) % screenshots.length;
      const screenshot = screenshots[current];
      if (preview) preview.href = screenshot.src;
      images.forEach(image => {
        image.src = screenshot.src;
        image.alt = screenshot.alt;
        image.width = screenshot.width;
        image.height = screenshot.height;
      });
      titles.forEach(title => { title.textContent = screenshot.title; });
    }

    preview.addEventListener('click', event => {
      if (typeof dialog.showModal !== 'function' || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });

    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => preview.focus({ preventScroll: true }));

    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-step]').forEach(button => {
      button.addEventListener('click', () => step(Number(button.dataset.galleryStep)));
    });
    if (screenshots.length > 1) {
      gallery.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        step(event.key === 'ArrowLeft' ? -1 : 1);
      });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const canHover = window.matchMedia('(hover: hover)');
      let inView = true;
      if (typeof IntersectionObserver !== 'undefined') {
        new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; }).observe(frame);
      }

      window.setInterval(() => {
        const hovering = canHover.matches && frame.matches(':hover');
        if (inView && !document.hidden && !dialog.open && !reducedMotion.matches && !hovering && !frame.querySelector(':focus-visible')) {
          step(1);
        }
      }, 7000);
    }
  }
</script>

<style>
  .gallery { min-width: 0; }
  .gallery h2 { margin: 0 0 12px; font-size: 21px; }
  .gallery-frame { position: relative; overflow: hidden; }
  .gallery-preview {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gallery-preview:hover { border-color: var(--accent); text-decoration: none; }
  .gallery-link { display: block; }
  .gallery-link:focus-visible { outline-offset: -5px; }
  .gallery-preview [data-gallery-image] {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .gallery-brand {
    position: absolute;
    bottom: 10px;
    left: 10px;
    width: clamp(56px, 20%, 98px);
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 1px 3px #141116d9);
  }
  .gallery-enlarge {
    display: grid;
    place-items: center;
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 32px;
    height: 32px;
    border-radius: 5px;
    background: #181320bf;
    color: #fff;
  }
  .gallery-arrow {
    position: absolute;
    inset-block: 0;
    display: grid;
    place-items: center;
    width: clamp(44px, 10%, 58px);
    padding: 0;
    border: 0;
    border-radius: 0;
    color: #fff;
    background: linear-gradient(var(--fade-direction), #181320bf, transparent);
    transition: opacity .18s ease;
  }
  .gallery-arrow-left { left: 0; --fade-direction: to right; }
  .gallery-arrow-right { right: 0; --fade-direction: to left; }
  .gallery-arrow:hover:not(:disabled) { background: linear-gradient(var(--fade-direction), #181320e6, transparent); }
  .gallery-arrow:focus-visible { outline-offset: -5px; }
  @media (hover: hover) {
    .gallery-arrow { opacity: 0; }
    .gallery-frame:is(:hover, :focus-within) .gallery-arrow { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-arrow { transition: none; }
  }
  .gallery-enlarge { z-index: 1; }

  .gallery-dialog {
    width: min(calc(100% - 24px), 1400px);
    max-height: calc(100dvh - 24px);
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .gallery-dialog::backdrop { background: var(--backdrop); }
  .gallery-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 12px;
  }
  .gallery-dialog-header h2 { margin: 0; font-size: 18px; }
  .gallery-dialog-header button { padding: 4px 12px; font-size: 14px; }
  .gallery-dialog [data-gallery-image] {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 90px);
    object-fit: contain;
    background: #141116;
  }
</style>
