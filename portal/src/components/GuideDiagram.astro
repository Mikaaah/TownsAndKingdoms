---
import { href } from '../lib/data';

interface Props {
  label: string;
}

const { label } = Astro.props;
const planks = href('media/textures/spruce-planks.png');
---

<div class="guide-diagram" role="group" aria-label={label} style={{ '--diagram-planks': `url("${planks}")` }}>
  <slot />
</div>

<style>
  @font-face {
    font-family: 'Minecraft Checklist';
    src: url('../assets/MinecraftChecklist.woff') format('woff');
    font-display: swap;
  }

  .guide-diagram {
    --diagram-gold: #ffd087;
    --diagram-muted: #ddd1c6;
    --diagram-wood: linear-gradient(#0009, #0009), var(--diagram-planks) 0 0 / 64px 64px repeat;
    box-sizing: border-box;
    container-type: inline-size;
    inline-size: min(100%, 840px);
    margin-block: 16px;
    padding: clamp(8px, 1.6vw, 15px);
    border: 3px solid #17120d;
    border-radius: 4px;
    background: linear-gradient(#000b, #000b), var(--diagram-planks) 0 0 / 64px 64px repeat;
    box-shadow: inset 0 0 0 1px #675641, 0 1px 2px #0009;
    color: #fff8ef;
    font-family: 'Minecraft Checklist', monospace;
    image-rendering: pixelated;
    text-shadow: 2px 2px #17100b;
  }

  .guide-diagram :global([data-guide-panel]) {
    min-inline-size: 0;
    border: 1px solid #927952;
    background: var(--diagram-wood);
    box-shadow: inset 0 0 0 2px #e0a75e20, 0 2px #08060390;
  }
</style>
