---
import GuideDiagram from './GuideDiagram.astro';
import { href } from '../lib/data';

interface Item {
  name: string;
  image: string;
}

interface Props {
  station: string;
  rows: Item[][];
  result: Item;
}

const { station, rows, result } = Astro.props;
---

<GuideDiagram label={'Craft ' + result.name}>
  <div class="crafting-recipe">
    <div class="crafting-panel crafting-input" data-guide-panel>
      <span>{station}</span>
      <table class="crafting-pattern" aria-label={rows.length + ' by ' + rows[0].length + ' ingredient pattern'}>
        <tbody>
          {rows.map(row => (
            <tr>
              {row.map(item => (
                <td title={item.name}>
                  <img src={href(item.image)} alt={item.name} width="32" height="32" loading="lazy" decoding="async" />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="crafting-panel crafting-result" data-guide-panel>
      <img src={href(result.image)} alt="" width="104" height="104" loading="lazy" decoding="async" />
      <span>1 {result.name}</span>
    </div>
  </div>
</GuideDiagram>

<style>
  .crafting-recipe {
    --panel-gap: clamp(16px, 5cqi, 38px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--panel-gap);
  }
  .crafting-panel {
    display: grid;
    min-block-size: clamp(102px, 23cqi, 186px);
    place-content: center;
    justify-items: center;
    gap: clamp(5px, 1.25cqi, 10px);
    padding: 8px 3px;
    font-size: clamp(12px, 2.2cqi, 18px);
    line-height: 1.26;
    text-align: center;
  }
  .crafting-input { position: relative; color: var(--diagram-muted); }
  .crafting-input::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(100% + var(--panel-gap) / 2);
    inline-size: clamp(10px, 2.9cqi, 22px);
    block-size: clamp(8px, 1.7cqi, 12px);
    translate: -50% -50%;
    clip-path: polygon(0 33%, 58% 33%, 58% 0, 100% 50%, 58% 100%, 58% 67%, 0 67%);
    background: var(--diagram-gold);
    content: '';
  }
  .crafting-pattern {
    inline-size: auto;
    margin: 0;
    border-collapse: separate;
    border-spacing: clamp(4px, 1.2cqi, 9px);
  }
  .crafting-pattern td { padding: 0; border: 0; }
  .crafting-pattern tr:hover { background: transparent; }
  .crafting-panel img {
    display: block;
    block-size: auto;
    filter: drop-shadow(2px 3px #1b1109);
  }
  .crafting-pattern img { inline-size: clamp(20px, 8cqi, 46px); }
  .crafting-result { color: var(--diagram-gold); }
  .crafting-result img { inline-size: clamp(50px, 14cqi, 104px); }
</style>
