---
import GuideDiagram from './GuideDiagram.astro';
import { href } from '../lib/data';

interface Item {
  name: string;
  image: string;
}

interface Props {
  station: string;
  rows: Item[][];
  result: Item;
}

const { station, rows, result } = Astro.props;
---

<GuideDiagram label={'Craft ' + result.name}>
  <div class="crafting-recipe" data-guide-panel>
    <div class="crafting-input">
      <span>{station}</span>
      <table class="crafting-grid" aria-label={rows.length + ' by ' + rows[0].length + ' crafting grid'}>
        <tbody>
          {rows.map(row => (
            <tr>
              {row.map(item => (
                <td title={item.name}>
                  <img src={href(item.image)} alt={item.name} width="32" height="32" loading="lazy" decoding="async" />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <span class="crafting-arrow" aria-hidden="true"></span>
    <div class="crafting-result">
      <span>1 {result.name}</span>
      <div class="result-slot">
        <img src={href(result.image)} alt="" width="48" height="48" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</GuideDiagram>

<style>
  .crafting-recipe {
    --slot-size: clamp(28px, 8.6cqi, 46px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(5px, 2.5cqi, 18px);
    padding: clamp(8px, 2.3cqi, 18px);
    text-align: center;
  }
  .crafting-input, .crafting-result {
    display: grid;
    justify-items: center;
    gap: 7px;
    font-size: clamp(12px, 2.45cqi, 17px);
    line-height: 1.3;
  }
  .crafting-input { color: var(--diagram-muted); }
  .crafting-result { color: var(--diagram-gold); }
  .crafting-grid { width: auto; margin: 0; border-collapse: separate; border-spacing: 2px; }
  .crafting-grid td, .result-slot {
    box-sizing: border-box;
    inline-size: var(--slot-size);
    block-size: var(--slot-size);
    padding: 1px;
    border: 2px solid #6a5a4a;
    border-right-color: #ceb795;
    border-bottom-color: #ceb795;
    background: #9e8d77;
  }
  .crafting-grid img, .result-slot img { display: block; width: 100%; height: auto; object-fit: contain; }
  .result-slot { inline-size: calc(var(--slot-size) * 1.35); block-size: calc(var(--slot-size) * 1.35); }
  .crafting-arrow {
    inline-size: clamp(14px, 4cqi, 27px);
    block-size: clamp(9px, 2.25cqi, 14px);
    margin-top: 19px;
    background: var(--diagram-gold);
    clip-path: polygon(0 32%, 59% 32%, 59% 0, 100% 50%, 59% 100%, 59% 68%, 0 68%);
  }
</style>
