---
import { href } from '../lib/data';

interface Props {
  name: string;
  size?: number;
  kind?: 'item' | 'ui';
}

const { name, size = 16, kind = 'item' } = Astro.props;
const directory = kind === 'ui' ? 'quest-ui' : 'quest-icons';
---
<img
  class="quest-icon"
  src={href(`media/${directory}/${name}.png`)}
  alt=""
  width={size}
  height={size}
  decoding="async"
/>

<style>
  .quest-icon {
    display: block;
    height: auto;
    flex-shrink: 0;
    object-fit: contain;
    image-rendering: pixelated;
  }
</style>
