---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { href, words } from '../lib/data';
import index from '../data/ponder.json';
import { guideItems } from '../scripts/ponder-guides.mjs';

const { scenes, categories } = index;
const titles = new Map<string, number>();
const itemNames = new Map<string, string>();
for (const scene of scenes) {
  titles.set(scene.title, (titles.get(scene.title) ?? 0) + 1);
  for (const step of scene.steps) {
    for (const item of guideItems(step)) {
      if (item.id && item.name) itemNames.set(item.id, item.name);
    }
  }
}
const nameFor = (id: string) => itemNames.get(id) || words(id);
const options = scenes.map(scene => ({
  ...scene,
  label: (titles.get(scene.title) ?? 0) > 1 ? `${scene.title} · ${words(scene.slug)}` : scene.title,
  itemNames: scene.anchors.map(nameFor),
  searchIds: [...new Set([...scene.anchors, ...scene.items, ...scene.blockIds])],
  captions: scene.steps.map(step => step.text).join(' '),
}));
const localIcons = new Map<string, boolean>();
function iconPath(icon?: { url?: string, animated?: boolean }) {
  if (!icon?.url || icon.animated || !icon.url.includes('/item/')) return '';
  if (!localIcons.has(icon.url)) localIcons.set(icon.url, existsSync(join(process.cwd(), 'public', icon.url)));
  return localIcons.get(icon.url) ? href(icon.url) : '';
}
const categoryNames = new Map(categories.map(category => [category.id, category.title]));
---
<section class="ponder-guides" data-ponder-guides aria-label="Ponder item guides">
  <div class="ponder-filters" data-ponder-controls hidden>
    <label>Find an item or guide<input data-ponder-query type="search" placeholder="Try Rotation Mechanism or Deployer" autocomplete="off" /></label>
    <label>Guide<select data-ponder-guide aria-describedby="ponder-results">
      {categories.map(category => <optgroup label={category.title}>
        {options.filter(scene => scene.category === category.id).map(scene =>
          <option value={scene.slug} data-title={scene.title} data-items={scene.searchIds.join(' ')} data-names={scene.itemNames.join(' ')} data-captions={scene.captions} selected={scene.slug === scenes[0].slug}>{scene.label}</option>
        )}
      </optgroup>)}
    </select></label>
    <p id="ponder-results" class="ponder-results" role="status">{scenes.length} guides</p>
  </div>
  <p class="ponder-empty" data-ponder-empty hidden>No guides match. Try an item name, item ID, or guide title.</p>
  <div data-ponder-articles>
    {scenes.map(scene => <article class="ponder-guide" id={'guide-' + scene.slug} data-guide={scene.slug} aria-labelledby={'title-' + scene.slug}>
      <header class="ponder-guide-header">
        <p class="ponder-category">{categoryNames.get(scene.category)}</p>
        <h2 id={'title-' + scene.slug}>{scene.title}</h2>
        {scene.anchors.length > 0 && <div class="ponder-key">
          <p>In Minecraft, hover over {scene.anchors.length === 1 ? 'this item' : 'one of these items'} and hold <kbd>W</kbd> to open Ponder.</p>
          <ul class="ponder-items" aria-label="Items with this Ponder guide">
            {scene.anchors.slice(0, 5).map(id => <li title={id}>{nameFor(id)}</li>)}
          </ul>
          {scene.anchors.length > 5 && <details class="ponder-more">
            <summary>Show {scene.anchors.length - 5} more items</summary>
            <ul class="ponder-items" aria-label="More items with this Ponder guide">{scene.anchors.slice(5).map(id => <li title={id}>{nameFor(id)}</li>)}</ul>
          </details>}
        </div>}
      </header>
      <ol class="ponder-steps">
        {scene.steps.map(step => {
          const items = guideItems(step);
          return <li>
          {step.title !== scene.title && <h3>{step.title}</h3>}
          <p>{step.text}</p>
          {items.length > 0 && <ul class="ponder-items ponder-step-items" aria-label="Items shown in this step">
            {items.map(item => {
              const image = iconPath(item.icon);
              return <li title={item.id}>
                {image && <img src={image} width="24" height="24" alt="" loading="lazy" decoding="async" />}
                {item.role && <span class="ponder-item-role">{item.role}</span>}
                <span>{item.count}{item.name || words(item.id)}</span>
              </li>;
            })}
          </ul>}
          </li>;
        })}
      </ol>
    </article>)}
  </div>
</section>
<script>
  import { initPonderGuides } from '../scripts/ponder-guides.mjs';
  initPonderGuides();
</script>
<style>
  .ponder-guides{border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);overflow:hidden}
  .ponder-guides [hidden]{display:none}
  .ponder-filters{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:12px 18px;padding:20px 24px;border-bottom:1px solid var(--border)}
  .ponder-filters label{display:grid;gap:7px;min-width:0;color:var(--muted);font-size:.875rem;font-weight:600}
  .ponder-filters input,.ponder-filters select{width:100%;min-height:44px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);padding:9px 12px;font:inherit;font-size:1rem}
  .ponder-filters :is(input,select):focus-visible,.ponder-more summary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}
  .ponder-results{grid-column:1/-1;margin:0;color:var(--muted);font-size:.875rem}
  .ponder-empty{margin:0;padding:24px;color:var(--muted)}
  .ponder-guide{padding:24px;scroll-margin-top:90px}
  .ponder-guide+.ponder-guide{border-top:1px solid var(--border)}
  .ponder-guide-header h2{margin:4px 0 14px;line-height:1.2}
  .ponder-category{margin:0;color:var(--accent);font-size:.875rem;font-weight:650}
  .ponder-key{padding:14px 16px;background:var(--bg);border:1px solid var(--border);border-radius:6px}
  .ponder-key p{margin:0 0 9px;color:var(--muted);line-height:1.55}
  .ponder-key kbd{display:inline-block;padding:0 5px;border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;background:var(--surface-raised);color:var(--text);font:inherit;font-size:.9em;font-weight:650;line-height:1.4}
  .ponder-items{display:flex;gap:6px 8px;flex-wrap:wrap;margin:0;padding:0;list-style:none}
  .ponder-items li{display:inline-flex;align-items:center;gap:6px;max-width:100%;overflow-wrap:anywhere;padding:4px 8px;border:1px solid var(--border);border-radius:5px;color:var(--text);font-size:.875rem}
  .ponder-more{margin-top:9px}
  .ponder-more summary{color:var(--muted);font-size:.875rem;cursor:pointer}
  .ponder-more ul{margin-top:8px}
  .ponder-steps{margin:22px 0 0;padding-left:24px}
  .ponder-steps>li{padding:0 0 17px 5px}
  .ponder-steps>li:last-child{padding-bottom:0}
  .ponder-steps>li::marker{color:var(--accent);font-weight:700}
  .ponder-steps h3{margin:0 0 5px;font-size:1.05rem}
  .ponder-steps p{margin:0;max-width:72ch;color:var(--text);line-height:1.65}
  .ponder-step-items{margin-top:9px}
  .ponder-step-items li{background:var(--bg)}
  .ponder-step-items img{width:24px;height:24px;object-fit:contain;image-rendering:pixelated}
  .ponder-item-role{color:var(--muted);font-size:.8125rem}
  @media(max-width:640px){.ponder-filters{grid-template-columns:minmax(0,1fr);padding:16px}.ponder-guide{padding:18px}.ponder-steps{padding-left:20px}}
</style>
