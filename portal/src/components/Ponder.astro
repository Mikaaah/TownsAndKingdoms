---
import index from '../data/ponder.json';
const { initialScene = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const first = index.scenes.find(scene => scene.slug === initialScene || scene.id === initialScene) || index.scenes[0];
const choices = index.scenes.map(({id,slug,title,anchors,dataUrl,category}) => ({id,slug,title,anchors,dataUrl,category}));
---
<section class="ponder" data-ponder data-base={base} data-initial={first.slug} data-scenes={JSON.stringify(choices)} aria-label="Interactive Ponder scenes">
  <div class="ponder-picker">
    <label>Find a scene<input data-ponder-filter type="search" placeholder="Search an item, process, or machine" autocomplete="off" /></label>
    <label>Scene<select data-ponder-select aria-label="Choose a Ponder scene">
      {index.scenes.map(scene => <option value={scene.slug} selected={scene.slug === first.slug}>{scene.title}</option>)}
    </select></label>
    <p class="ponder-filter-status" data-ponder-filter-status role="status" aria-live="polite">{index.scenes.length} scenes</p>
  </div>
  <div class="ponder-stage" data-ponder-stage>
    <div class="ponder-canvas" data-ponder-canvas role="img" tabindex="0" aria-label="Interactive three-dimensional machine and item staging"></div>
    <div class="ponder-stage-status" data-ponder-status aria-live="polite">Preparing the scene…</div>
    <div class="ponder-hover" data-ponder-hover hidden></div>
    <div class="ponder-focus" data-ponder-focus hidden></div>
    <button class="ponder-camera" data-ponder-camera type="button" title="Reset the camera">Reset view</button>
    <span class="ponder-controls-hint">Drag to orbit · scroll to zoom · right-drag to pan</span>
  </div>
  <div class="ponder-timeline" aria-label="Scene timeline">
    <div class="ponder-transport">
      <button data-ponder-prev type="button" aria-label="Previous step">←</button>
      <button data-ponder-play type="button" aria-label="Play scene">Play</button>
      <button data-ponder-next type="button" aria-label="Next step">→</button>
      <span data-ponder-counter>Step 1 of {first.steps.length}</span>
    </div>
    <label class="ponder-scrub-label"><span class="sr-only">Scrub through the scene</span><input data-ponder-scrub type="range" min="0" max="1000" value="0" step="1" aria-label="Scene progress" /></label>
  </div>
  <div class="ponder-instruction" aria-live="polite" aria-atomic="true">
    <div class="ponder-step-eyebrow" data-ponder-step-label>Step 1</div>
    <h3 data-ponder-step-title>{first.steps[0]?.title}</h3>
    <p data-ponder-step-text>{first.steps[0]?.text}</p>
    <div class="ponder-item-flow" data-ponder-item-flow></div>
    <section class="ponder-staged-fallback" data-ponder-staged-fallback hidden aria-label="Staged ingredients">
      <h4>Staged ingredients</h4>
      <div class="ponder-item-flow" data-ponder-staged-items></div>
    </section>
  </div>
  <div class="ponder-step-list" data-ponder-step-list aria-label="Choose a scene step">
    {first.steps.map((step,index) => <button data-step={index} class:list={{active:index === 0}} type="button"><span>{index+1}</span>{step.title}</button>)}
  </div>
  <noscript><p>Scene instructions</p><ol>{first.steps.map(step => <li>{step.text}</li>)}</ol></noscript>
</section>
<script>
  import { initPonders } from '../scripts/ponder.js';
  initPonders();
</script>
<style is:global>
  .ponder{border:1px solid var(--border,#3c3542);border-radius:var(--radius,10px);overflow:hidden;background:var(--surface,#1b191e)}
  .ponder-picker{display:grid;grid-template-columns:1fr 1.3fr;gap:16px;padding:20px;border-bottom:1px solid var(--border,#34303e)}
  .ponder-picker label{display:grid;gap:7px;min-width:0;color:var(--muted,#c0b8c3);font-size:.875rem;font-weight:600}
  .ponder-filter-status{grid-column:1/-1;margin:0;color:var(--muted,#c0b8c3);font-size:.8125rem}
  .ponder-picker input,.ponder-picker select{width:100%;min-height:44px;border:1px solid var(--border,#3c3542);border-radius:6px;background:var(--bg,#131216);color:var(--text,#f3f0eb);padding:10px 12px;font:inherit;font-size:1rem}
  .ponder-stage{height:480px;position:relative;overflow:hidden;background:var(--bg,#131216);isolation:isolate}
  .ponder-canvas,.ponder-canvas canvas{display:block;width:100%;height:100%;touch-action:none}
  .ponder-stage-status{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted,#c0b8c3);font-size:1rem;pointer-events:none}
  .ponder-stage-status[hidden]{display:none}
  .ponder.ponder-no-3d .ponder-stage{height:auto;min-height:0;padding:18px 24px;background:var(--surface,#1b191e)}
  .ponder.ponder-no-3d .ponder-stage-status{position:static;display:block;line-height:1.7;font-size:.875rem}
  .ponder.ponder-no-3d .ponder-canvas,.ponder.ponder-no-3d .ponder-camera,.ponder.ponder-no-3d .ponder-controls-hint,.ponder.ponder-no-3d .ponder-focus,.ponder.ponder-no-3d .ponder-hover{display:none!important}
  .ponder-camera{position:absolute;right:16px;top:16px;min-height:44px;background:var(--surface,#1b191e);border:1px solid var(--border,#3c3542);border-radius:6px;color:var(--text,#f3f0eb);padding:9px 12px;font-size:.875rem;cursor:pointer}
  .ponder-controls-hint{position:absolute;left:16px;bottom:12px;color:var(--muted,#c0b8c3);font-size:.75rem;pointer-events:none}
  .ponder-hover{position:absolute;padding:8px 11px;max-width:240px;border:1px solid var(--border,#3c3542);border-radius:6px;background:var(--surface-raised,#242128);box-shadow:0 8px 20px #0003;color:var(--text,#f3f0eb);font-size:.875rem;pointer-events:none;z-index:3}
  .ponder-hover small{display:block;margin-top:3px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted,#c0b8c3);font-size:.75rem;overflow-wrap:anywhere}
  .ponder-focus{position:absolute;transform:translate(-50%,-100%);padding:5px 9px;border:1px solid var(--border,#3c3542);border-radius:5px;color:var(--text,#f3f0eb);background:var(--surface-raised,#242128);white-space:nowrap;font-size:.8125rem;pointer-events:none;z-index:2}
  .ponder-timeline{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:18px;padding:13px 20px;border-top:1px solid var(--border,#3c3542);border-bottom:1px solid var(--border,#3c3542)}
  .ponder-transport{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ponder-transport button{min-width:44px;min-height:44px;padding:8px 12px;background:transparent;border:1px solid var(--border,#3c3542);border-radius:5px;color:var(--text,#f3f0eb);font-size:.875rem;cursor:pointer}.ponder-transport button:disabled{opacity:.4;cursor:default}
  .ponder-transport span{margin-left:4px;color:var(--muted,#c0b8c3);font-size:.8125rem;white-space:nowrap}
  .ponder-scrub-label{display:flex;min-width:0}.ponder-scrub-label input{width:100%;min-height:44px;accent-color:var(--accent,#d6b7e8);cursor:pointer}
  .ponder-instruction{padding:24px 26px 21px;min-height:150px}.ponder-step-eyebrow{text-transform:uppercase;letter-spacing:.08em;color:var(--accent,#d6b7e8);font-size:.75rem;font-weight:600}.ponder-instruction h3{margin:8px 0 10px;font-size:1.18rem;letter-spacing:-.02em}.ponder-instruction p{margin:0;max-width:68ch;color:var(--muted,#c0b8c3);font-size:1rem;line-height:1.7}
  .ponder-item-flow{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap}.ponder-item-flow:empty{display:none}.ponder-item-flow .ponder-item{display:flex;align-items:center;gap:7px;border:1px solid var(--border,#3c3542);border-radius:5px;background:var(--bg,#131216);padding:6px 9px;color:var(--text,#f3f0eb);font-size:.875rem}.ponder-item-flow img{width:22px;height:22px;object-fit:contain;image-rendering:pixelated}.ponder-item-flow .flow-arrow{color:var(--muted,#c0b8c3);font-size:.875rem}
  .ponder-staged-fallback{margin-top:20px;padding-top:16px;border-top:1px solid var(--border,#3c3542)}
  .ponder-staged-fallback[hidden]{display:none}.ponder-staged-fallback h4{margin:0;font-size:.875rem;font-weight:600;color:var(--muted,#c0b8c3)}
  .ponder-step-list{display:flex;flex-wrap:wrap;gap:8px;padding:0 26px 24px}.ponder-step-list button{display:flex;align-items:center;gap:7px;min-height:44px;padding:9px 12px;border:1px solid var(--border,#3c3542);border-radius:5px;background:transparent;color:var(--muted,#c0b8c3);font:inherit;font-size:.875rem;cursor:pointer}.ponder-step-list button.active{border-color:var(--accent,#d6b7e8);color:var(--text,#f3f0eb);background:var(--surface-raised,#242128)}.ponder-step-list button span{font-family:ui-monospace,monospace;font-size:.75rem;color:var(--accent,#d6b7e8)}
  .ponder button:focus-visible,.ponder input:focus-visible,.ponder select:focus-visible{outline:2px solid var(--focus,var(--gold,#d5b678));outline-offset:3px}
  .ponder-canvas:focus-visible{outline:2px solid var(--focus,var(--gold,#d5b678));outline-offset:-4px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:700px){.ponder-picker{grid-template-columns:1fr;gap:12px;padding:16px}.ponder-stage{height:365px}.ponder-timeline{grid-template-columns:1fr;gap:10px;padding:12px 16px}.ponder-instruction{padding:20px 18px}.ponder-step-list{padding:0 18px 20px}.ponder-controls-hint{font-size:.75rem;left:12px;max-width:75%}.ponder-transport{justify-content:space-between}}
</style>
