---
import skills from '../data/skills.json';
import professionLabels from '../lib/skill-profession-labels.json';
const {background, connectionColors}=skills.category;
const base=import.meta.env.BASE_URL;
const mapTheme={
  '--sp-map-image': `url("${base}${background.texture}")`,
  '--sp-map-tile': `${background.width}px ${background.height}px`,
  '--sp-line-locked': connectionColors.locked.fill,
  '--sp-line-available': connectionColors.available.fill,
  '--sp-line-affordable': connectionColors.affordable.fill,
  '--sp-line-unlocked': connectionColors.unlocked.fill
};
---
<section class="skill-planner" data-skill-planner data-base={base} style={mapTheme} aria-label="Interactive skill tree planner">
  <div class="sp-toolbar">
    <label class="sp-budget">Campaign level <input data-skill-level type="number" min="1" max="100" value="100" placeholder="Custom" inputmode="numeric" /></label>
    <details class="sp-budget-options"><summary>Custom budget</summary><label class="sp-budget">Points <input data-skill-budget type="number" min="0" max={skills.category.pointCap} value={skills.category.pointCap} inputmode="numeric" /></label></details>
    <div class="sp-counter"><strong data-skill-spent>0</strong><span>spent</span></div>
    <div class="sp-counter"><strong data-skill-available>{skills.category.pointCap}</strong><span>available</span></div>
    <div class="sp-actions"><button type="button" data-skill-undo disabled>Undo</button><button type="button" data-skill-reset>Reset</button><button class="sp-primary" type="button" data-skill-share>Share build</button></div>
  </div>
  <div class="sp-share" data-skill-share-panel hidden><label>Build link <input data-skill-share-link type="text" readonly /></label></div>
  <div class="sp-layout">
    <div class="sp-tree-panel">
      <div class="sp-search">
        <label for="skill-search">Find a skill</label>
        <input id="skill-search" data-skill-search type="search" placeholder="Name, effect or discipline…" autocomplete="off" />
        <div class="sp-results" data-skill-results hidden role="list" aria-label="Matching skills"></div>
      </div>
      <nav class="sp-branches" aria-label="Skill disciplines">{skills.branches.map(branch=>{
        const root=skills.nodes.find(node=>node.root&&node.branch===branch.id);
        const labelWidth=professionLabels.widths[branch.id as keyof typeof professionLabels.widths];
        return <button type="button" data-skill-branch={branch.id}>
          {root&&<img src={base+root.icon} width="20" height="20" alt="" />}
          {labelWidth
            ? <img class="sp-profession-label" src={base+professionLabels.path+branch.id+'.png'} width={labelWidth} height={professionLabels.height} alt={branch.title} />
            : branch.title}
        </button>;
      })}</nav>
      <div class="sp-canvas" data-skill-canvas data-background-position={background.position}>
        <svg data-skill-map tabindex="0" role="group" aria-label="Skill tree. Drag to pan and scroll or pinch to zoom." aria-describedby="skill-map-help"><g data-skill-camera></g></svg>
        <div class="sp-map-controls" aria-label="Tree view controls"><button type="button" data-skill-zoom="in" aria-label="Zoom in">+</button><button type="button" data-skill-zoom="out" aria-label="Zoom out">−</button><button type="button" data-skill-fit>Fit tree</button><button type="button" data-skill-route-mode aria-pressed="false">Plan route</button></div>
        <div class="sp-tooltip" data-skill-tooltip hidden><strong></strong><span></span></div>
      </div>
      <div class="sp-map-footer"><p id="skill-map-help" data-skill-map-help>Click to allocate. Right-click to refund. Drag to pan.</p><div class="sp-legend"><span class="is-allocated">Allocated</span><span class="is-ready">Available</span><span>Locked</span><span class="is-route" data-skill-route-legend hidden>Planned route</span></div></div>
    </div>
    <aside class="sp-sidebar" aria-label="Selected skill and build bonuses">
      <section class="sp-detail" aria-live="polite">
        <p class="sp-eyebrow" data-skill-detail-branch>Skill tree</p>
        <h2 data-skill-detail-title>Choose your first skill</h2>
        <p data-skill-detail-description>Start at any discipline’s root, then follow its connected skills. You can combine disciplines within the shared point budget.</p>
        <p class="sp-requirement" data-skill-detail-requirement>All six roots are available.</p>
        <div class="sp-detail-actions"><button type="button" class="sp-primary" data-skill-allocate disabled>Allocate</button><button type="button" data-skill-refund disabled>Refund</button><button type="button" data-skill-route-here disabled>Show route</button></div>
      </section>
      <section class="sp-route" data-skill-route-panel aria-label="Planned route" hidden>
        <h2 data-skill-route-title>Planned route</h2>
        <p data-skill-route-description role="status"></p>
        <details data-skill-route-steps hidden><summary>Unlock order</summary><ol data-skill-route-list></ol></details>
        <div class="sp-detail-actions" data-skill-route-actions hidden><button type="button" data-skill-route-fit>Fit route</button><button type="button" class="sp-primary" data-skill-route-apply>Allocate route</button></div>
      </section>
      <section class="sp-summary"><h2>Build bonuses</h2><p class="sp-empty" data-skill-empty>Allocate a skill to see its bonuses here.</p><dl data-skill-stats></dl><div data-skill-passives></div></section>
    </aside>
  </div>
  <p class="sp-status" data-skill-status role="status" aria-live="polite">{skills.nodes.length} skills · {skills.category.pointCap}-point limit</p>
</section>
<p class="subtle">The supplied character tree has a {skills.category.pointCap}-point spending limit. <a href={base+'mechanics/#prestige'}>Prestige levels</a> can raise your total earned points in TNK Progression 1.1.8.</p>
<p class="sp-lettering-credit subtle">Profession lettering by CraftronGaming.</p>
<script>
  import {initSkillPlanners} from '../scripts/skill-planner.js';
  initSkillPlanners();
  document.addEventListener('astro:page-load',()=>initSkillPlanners());
</script>
<style is:global>
  .skill-planner{
    --sp-bg:var(--bg);--sp-surface:var(--surface);--sp-raised:var(--surface-raised);
    --sp-border:var(--border);--sp-text:var(--text);--sp-muted:var(--muted);
    --sp-accent:var(--accent);--sp-gold:var(--gold-text);--sp-route:#ffd574;
    border:1px solid var(--sp-border);border-radius:var(--radius);overflow:hidden;background:var(--sp-surface);color:var(--sp-text)
  }
  .skill-planner button,.skill-planner input{font:inherit}
  .skill-planner button{border:1px solid var(--sp-border);border-radius:6px;background:var(--sp-surface);color:var(--sp-text);min-height:44px;padding:.55rem .75rem;font-size:.875rem;cursor:pointer;line-height:1.4;transition:background-color .12s,border-color .12s}
  .skill-planner button:hover:not(:disabled){border-color:var(--sp-accent);background:var(--sp-raised)}
  .skill-planner button:focus-visible,.skill-planner input:focus-visible,.skill-planner summary:focus-visible{outline:2px solid var(--focus,var(--sp-gold));outline-offset:3px}
  .skill-planner [data-skill-map]:focus-visible{outline:2px solid var(--focus,var(--sp-gold));outline-offset:-4px}
  .skill-planner button:disabled{opacity:.4;cursor:not-allowed}
  .skill-planner .sp-primary{background:var(--primary);border-color:var(--primary);color:var(--primary-ink);font-weight:600}
  .skill-planner .sp-primary:hover:not(:disabled){background:var(--primary-hover);border-color:var(--primary-hover);color:var(--primary-ink)}
  .sp-toolbar{display:flex;align-items:center;gap:1.15rem;padding:1rem 1.15rem;border-bottom:1px solid var(--sp-border);flex-wrap:wrap}
  .sp-budget{display:flex;align-items:center;gap:.6rem;font-size:.875rem;color:var(--sp-muted)}
  .skill-planner input{box-sizing:border-box;background:var(--sp-bg);color:var(--sp-text);border:1px solid var(--sp-border);border-radius:6px;padding:.6rem .75rem;min-width:0;min-height:44px;font-size:1rem}
  .sp-budget input{width:76px;font-variant-numeric:tabular-nums}
  .sp-budget-options{position:relative;font-size:.8125rem;color:var(--sp-muted)}
  .sp-budget-options>summary{min-height:44px;cursor:pointer;padding:.6rem 0}
  .sp-budget-options>.sp-budget{position:absolute;top:calc(100% + .6rem);right:0;z-index:12;background:var(--sp-raised);border:1px solid var(--sp-border);border-radius:7px;padding:.8rem;box-shadow:0 8px 20px #0004}
  .sp-counter{display:flex;gap:.35rem;align-items:baseline;font-size:.875rem;color:var(--sp-muted)}
  .sp-counter strong{font-size:1.12rem;font-variant-numeric:tabular-nums;font-weight:650;color:var(--sp-text)}
  .sp-actions{display:flex;gap:.5rem;margin-left:auto;font-size:.875rem}
  .sp-share{padding:.8rem 1.15rem;border-bottom:1px solid var(--sp-border)}
  .sp-share label{font-size:.875rem;color:var(--sp-muted);display:flex;gap:.7rem;align-items:center}
  .sp-share input{flex:1;width:100%}
  .sp-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px}
  .sp-tree-panel{min-width:0;position:relative}
  .sp-search{position:relative;padding:1rem 1rem .75rem;display:flex;align-items:center;gap:.7rem}
  .sp-search label{font-size:.875rem;white-space:nowrap;color:var(--sp-muted)}
  .sp-search>input{width:100%;font-size:1rem}
  .sp-results{position:absolute;z-index:6;top:calc(100% - .5rem);left:1rem;right:1rem;max-height:340px;overflow:auto;padding:.35rem;background:var(--sp-raised);border:1px solid var(--sp-border);border-radius:8px;box-shadow:0 12px 30px #0005}
  .sp-results button{display:flex;flex-direction:column;text-align:left;width:100%;border:0;border-radius:4px;gap:.15rem;padding:.6rem .7rem}
  .sp-results button span{font-size:.8125rem;color:var(--sp-muted)}
  .sp-results p{font-size:.875rem;margin:.6rem}
  .sp-branches{display:flex;gap:.3rem;flex-wrap:wrap;padding:0 1rem .85rem;border-bottom:1px solid var(--sp-border)}
  .sp-branches button{display:inline-flex;align-items:center;gap:.35rem;font-size:.8125rem;padding:.5rem .65rem;background:transparent}
  .sp-branches img{image-rendering:pixelated}
  .sp-branches .sp-profession-label{flex:none;width:auto;height:.875rem}
  :root[data-theme='light'] .sp-branches .sp-profession-label{filter:invert(1)}
  .sp-canvas{height:600px;min-height:560px;position:relative;overflow:hidden;background:#211e2d var(--sp-map-image) center center/cover;color:#f2e3f4;--sp-map-highlight:#fff2bc}
  .sp-canvas[data-background-position="tile"]{background-size:var(--sp-map-tile)}
  .sp-canvas svg{display:block;width:100%;height:100%;touch-action:none;cursor:grab;user-select:none;outline-offset:-4px}
  .sp-canvas svg.is-dragging{cursor:grabbing}
  .sp-connection{stroke:var(--sp-line-locked);stroke-width:2;fill:none}
  .sp-connection.is-active{stroke:var(--sp-line-unlocked);stroke-width:2.8}
  .sp-connection.is-open{stroke:var(--sp-line-available)}
  .sp-connection.is-route{stroke:var(--sp-route);stroke-width:3.5;stroke-linecap:round}
  .sp-node{cursor:pointer;outline:none}
  .sp-node circle{fill:transparent;stroke:transparent;stroke-width:2.2}
  .sp-node image{pointer-events:none;image-rendering:pixelated}
  .sp-node .sp-node-icon{opacity:.65}
  .sp-node.is-root .sp-node-icon,.sp-node.is-ready .sp-node-icon,.sp-node.is-allocated .sp-node-icon,.sp-node.is-focused .sp-node-icon{opacity:1}
  .sp-node text{paint-order:stroke;stroke:#1e1c2a;stroke-width:3px;stroke-linejoin:round;pointer-events:none}
  .sp-node.is-focused circle,.sp-node:focus-visible circle{stroke:var(--sp-map-highlight);stroke-width:3.2}
  .sp-node:hover circle{stroke:var(--sp-map-highlight)}
  .sp-node.is-route .sp-route-ring{fill:none;stroke:var(--sp-route);stroke-width:2.8;pointer-events:none}
  .sp-node.is-route-target .sp-route-ring{stroke-width:4.6}
  .sp-node:not(.is-route) .sp-route-ring{display:none}
  .sp-map-controls{position:absolute;bottom:1rem;left:1rem;display:flex;gap:.3rem}
  .sp-map-controls button{background:var(--sp-surface);font-size:.875rem;min-width:44px;min-height:44px;box-shadow:0 2px 5px #0002}
  .sp-map-controls button:first-child,.sp-map-controls button:nth-child(2){font-size:1rem;padding:.35rem .5rem}
  .sp-map-controls [aria-pressed="true"]{border-color:var(--sp-route);color:var(--sp-route)}
  .sp-tooltip{position:absolute;z-index:5;background:var(--sp-raised);border:1px solid var(--sp-border);padding:.6rem .75rem;border-radius:7px;pointer-events:none;width:max-content;max-width:260px;box-shadow:0 6px 20px #0004}
  .sp-tooltip strong,.sp-tooltip span{display:block;font-size:.875rem}
  .sp-tooltip span{font-size:.8125rem;margin-top:.2rem;color:var(--sp-muted)}
  .sp-map-footer{display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap;padding:.75rem 1rem;border-top:1px solid var(--sp-border);color:var(--sp-muted);font-size:.75rem}
  .sp-map-footer p{margin:0}
  .sp-legend{display:flex;gap:.7rem}
  .sp-legend span::before{content:'';display:inline-block;width:6px;height:6px;border:1px solid var(--sp-line-locked);border-radius:50%;margin-right:.3rem}
  .sp-legend .is-allocated::before{background:var(--sp-line-unlocked);border-color:var(--sp-line-unlocked)}
  .sp-legend .is-ready::before{background:var(--sp-line-affordable);border-color:var(--sp-line-affordable)}
  .sp-legend .is-route::before{background:var(--sp-route);border-color:var(--sp-route)}
  .sp-sidebar{border-left:1px solid var(--sp-border);min-width:0}
  .sp-detail,.sp-summary,.sp-route{padding:1.1rem}
  .sp-detail,.sp-route{border-bottom:1px solid var(--sp-border)}
  .sp-sidebar h2{font-family:inherit;font-size:1rem;line-height:1.4;margin:0 0 .7rem;font-weight:650}
  .sp-eyebrow{text-transform:uppercase;letter-spacing:.08em;color:var(--sp-accent);font-size:.75rem;margin:0 0 .45rem}
  .sp-detail>[data-skill-detail-description]{font-size:1rem;line-height:1.7;white-space:pre-line;color:var(--sp-muted);margin:.6rem 0}
  .sp-requirement{font-size:.875rem;line-height:1.6;margin:.8rem 0;color:var(--sp-gold)}
  .sp-detail-actions{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.875rem}
  .sp-route h2{color:var(--sp-route)}
  .sp-route p,.sp-route summary,.sp-route li{font-size:.875rem;line-height:1.6;color:var(--sp-muted)}
  .sp-route p{margin:0 0 .65rem}
  .sp-route summary{cursor:pointer}
  .sp-route ol{max-height:11rem;margin:.4rem 0 .8rem;padding-left:1.4rem;overflow:auto}
  .sp-route li[data-prerequisite]{font-size:.8125rem}
  .sp-route .sp-detail-actions{margin-top:.7rem}
  .sp-summary{max-height:590px;overflow:auto}
  .sp-empty{font-size:.875rem;line-height:1.7;color:var(--sp-muted);margin:0}
  .sp-summary dl{margin:0}
  .sp-stat{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.5rem;padding:.65rem 0;border-bottom:1px solid var(--sp-border);font-size:.875rem;align-items:start}
  .sp-stat dt{line-height:1.5;color:var(--sp-muted);min-width:0;overflow-wrap:anywhere}
  .sp-stat dt small{display:block;font-size:.75rem;color:var(--sp-muted)}
  .sp-stat dd{margin:0;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap;color:var(--sp-text)}
  .sp-passive-title{font-size:.875rem!important;margin:1rem 0 .35rem!important}
  .sp-passive-note{font-size:.8125rem;line-height:1.6;color:var(--sp-muted);margin:.6rem 0 0}
  .sp-status{margin:0;padding:.75rem 1.1rem;font-size:.8125rem;color:var(--sp-muted);border-top:1px solid var(--sp-border);min-height:1.2em}
  .sp-lettering-credit{font-size:.75rem;margin:.45rem 0 0}
  .skill-planner [hidden]{display:none!important}
  @media(max-width:1000px){.sp-layout{grid-template-columns:minmax(0,1fr) 250px}.sp-sidebar .sp-detail,.sp-sidebar .sp-summary,.sp-sidebar .sp-route{padding:.9rem}.sp-search{display:block}.sp-search label{display:block;margin-bottom:.4rem}}
  @media(max-width:760px){.sp-layout{display:block}.sp-sidebar{border-left:0;border-top:1px solid var(--sp-border);display:grid;grid-template-columns:1fr 1fr}.sp-detail{border-bottom:0;border-right:1px solid var(--sp-border)}.sp-summary{max-height:380px}.sp-route{grid-column:1/-1;border-top:1px solid var(--sp-border);grid-row:2}.sp-canvas{height:500px;min-height:480px}.sp-toolbar{gap:.7rem;padding:.8rem}.sp-actions{width:100%;margin-left:0}.sp-actions button{flex:1}.sp-search{display:flex}.sp-search label{margin:0}.sp-map-footer{font-size:.75rem}.sp-legend{gap:.4rem}}
  @media(max-width:450px){.sp-sidebar{display:block}.sp-detail{border-right:0;border-bottom:1px solid var(--sp-border)}.sp-summary{max-height:300px}.sp-search{display:block}.sp-search label{margin:0 0 .4rem}.sp-counter{font-size:.8125rem}.sp-budget-options>.sp-budget{right:auto;left:0}.sp-actions button{padding-inline:.5rem}}
</style>
