---
import '../styles/handbook-guide.css';
import Layout from '../layouts/Layout.astro';
import MaterialsChecklist from './MaterialsChecklist.astro';
import QuestIcon from './QuestIcon.astro';
import type { ComponentProps } from 'astro/types';
import { href } from '../lib/data';

interface Figure {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption?: string;
}

interface Guide {
  title: string;
  description: string;
  icon: string;
  materials: ComponentProps<typeof MaterialsChecklist>['items'];
  steps: { id?: string; title: string; text: string; figure?: Figure }[];
  tips?: { id?: string; title: string; text: string }[];
  links?: { label: string; path: string }[];
}

interface Props {
  id: string;
  guide: Guide;
}

const { id, guide } = Astro.props;
const guideHref = (path: string) => path.startsWith('https://') ? path : href(path);
---
<Layout title={guide.title} description={guide.description}>
  <p class="eyebrow"><a class="build-guide-parent" href={href('tutorials/')}><QuestIcon name="back2" kind="ui" />Build guides</a></p>
  <header class="build-title">
    <QuestIcon name={guide.icon} size={38} />
    <h1>{guide.title}</h1>
  </header>
  <p class="intro">{guide.description}</p>

  <MaterialsChecklist id={id} items={guide.materials} />

  <section aria-labelledby="setup-title">
    <h2 id="setup-title">Set it up</h2>
    <ol class="build-steps">
      {guide.steps.map(step => <li id={step.id}>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
        {step.figure && <figure class="guide-figure">
          <img src={href(step.figure.src)} width={step.figure.width} height={step.figure.height}
            alt={step.figure.alt} loading="lazy" decoding="async" />
          {step.figure.caption && <figcaption>{step.figure.caption}</figcaption>}
        </figure>}
      </li>)}
    </ol>
  </section>

  {guide.tips?.length ? <section class="build-tips" aria-labelledby="tips-title">
    <h2 id="tips-title">Troubleshooting</h2>
    <dl>
      {guide.tips.map(tip => <div id={tip.id}><dt>{tip.title}</dt><dd>{tip.text}</dd></div>)}
    </dl>
  </section> : null}

  {guide.links?.length ? <nav class="build-links" aria-label="Build references">
    {guide.links.map(link => <a href={guideHref(link.path)}>{link.label}</a>)}
  </nav> : null}
</Layout>

<style>
  .build-guide-parent { display: inline-flex; align-items: center; gap: 6px; }
  .build-title { display: flex; align-items: center; gap: 14px; margin: 0 0 10px; }
  .build-title h1 { margin: 0; }
  .build-steps { display: grid; gap: 12px; margin: 0; padding-inline-start: 32px; }
  .build-steps > li { margin: 0; padding: 13px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .build-steps > li::marker { color: var(--gold-text); font-weight: 700; }
  .build-steps h3 { margin: 0; font-size: 18px; }
  .build-steps p { margin: 5px 0 0; color: var(--muted); }
  .build-steps .guide-figure { margin: 12px 0 0; }
  .build-steps img { width: 100%; border: 1px solid var(--border-soft); border-radius: 5px; }
  .build-tips { margin-top: 25px; }
  .build-tips dl { display: grid; gap: 9px; margin: 0; }
  .build-tips dt { font-weight: 650; }
  .build-tips dd { margin: 2px 0 0; color: var(--muted); }
  .build-steps [id], .build-tips [id] { scroll-margin-top: calc(var(--header-height) + 16px); }
  .build-steps li:target { border-color: var(--gold-text); }
  .build-tips div:target dt { color: var(--gold-text); }
  .build-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--border-soft); }
  .build-links a { display: inline-flex; align-items: center; min-height: 42px; font-weight: 600; }

  @media (max-width: 580px) {
    .build-title { gap: 10px; }
    .build-steps { padding-inline-start: 26px; }
    .build-steps > li { padding-inline: 12px; }
  }
</style>
