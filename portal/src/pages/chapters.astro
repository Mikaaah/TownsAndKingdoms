---
import Layout from '../layouts/Layout.astro';
import {data,href,pretty,words} from '../lib/data';
const chapters=data('chapters');
---
<Layout title="Progression chapters" description="The Towns & Kingdoms roadmap, from the first workshop to advanced engineering, magic and the Creation Core.">
 <p class="eyebrow">Handbook / Progression</p><h1>Progression chapters</h1><p class="intro">Follow the ten chapters from basic tools through mechanical production, electrical engineering, magic and the Creation Core.</p>
 <div class="callout"><strong>Production requirements</strong><p>Chapters explain how manufacturing systems connect. Check an individual recipe for its required mechanisms and machines; exploration and character development can continue alongside production.</p></div>
 <nav class="toc-inline" aria-label="Chapter navigation">{chapters.map((c:any)=><a href={'#'+c.id}>{c.roman} · {c.title}</a>)}</nav>
 <div class="chapter-list">{chapters.map((c:any)=><article class="chapter-card" id={c.id}><div class="chapter-number">{c.roman}</div><div><p class="eyebrow" style="margin-bottom:8px">Chapter {c.number}</p><h2>{c.title}</h2><p>{c.summary}</p>{c.mechanism&&<p><span class="tag tag-gold">{words(c.mechanism)}</span></p>}{c.milestones?.length>0&&<ul>{c.milestones.map((m:any)=><li><a href={href('recipes/?q='+encodeURIComponent(m.id||m))}>{pretty(m)||words(m)}</a></li>)}</ul>}<a class="button" href={href('recipes/?q='+encodeURIComponent(c.mechanism||c.title))}>Explore this production stage →</a></div></article>)}</div>
</Layout>
