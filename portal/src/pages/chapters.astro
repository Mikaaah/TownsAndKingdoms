---
import Layout from '../layouts/Layout.astro';
import { data, href } from '../lib/data';

interface Prerequisite {
  id: string;
  title: string;
  chapterId?: string;
  chapterTitle?: string;
}

interface QuestObjective {
  label: string;
  type: string;
  count?: number;
}

interface Quest {
  id: string;
  title: string;
  subtitle?: string;
  description: string[];
  dependencyRequirement?: 'one_completed';
  prerequisites: Prerequisite[];
  tasks: QuestObjective[];
  rewards?: QuestObjective[];
}

interface Chapter {
  id: string;
  number: number;
  roman: string;
  title: string;
  quests: Quest[];
}

interface ChapterInfo {
  purpose: string;
  machineSource?: string;
  machines: { id: string; title: string }[];
}

const chapters: Chapter[] = data('chapter-questlines');
const chapterInfo: Record<string, ChapterInfo> = data('chapter-machines', {});
const spruce = href('media/textures/spruce-planks.png');
const isSecret = (chapter: Chapter) => chapter.number === 10 && chapter.quests.length === 0;
const objectiveLabel = (objective: QuestObjective) =>
  (objective.count ?? 1) > 1 ? `${objective.count} × ${objective.label}` : objective.label;
---
<Layout title="Chapter questlines" description="Follow the Towns & Kingdoms chapter questlines from the in-game quest book.">
  <p class="eyebrow">Handbook / Progression</p>
  <h1>Chapter questlines</h1>
  <p class="intro">Pick a chapter, then open a quest to see its objectives. Prerequisite links take you to the quests it depends on.</p>

  <nav class="chapter-roadmap" aria-label="Jump to a chapter">
    <ol class="chapter-jumps">
      {chapters.map(chapter => <li>
        <a class="chapter-jump" href={'#' + chapter.id}>
          <span class="chapter-jump-number"><span class="sr-only">Chapter </span>{chapter.roman}</span>
          <span>{isSecret(chapter) ? 'Secret' : chapter.title}</span>
        </a>
      </li>)}
    </ol>
  </nav>

  <div class="chapter-stages" style={{ '--chapter-spruce': `url("${spruce}")` }}>
    {chapters.map(chapter => {
      const secret = isSecret(chapter);
      const info = secret ? undefined : chapterInfo[chapter.id];
      return (
        <article class="chapter-stage" id={chapter.id} data-quest-chapter={chapter.id} aria-labelledby={chapter.id + '-title'}>
          <details class="chapter-disclosure" open={chapter.number === 1 || secret}>
            <summary class="chapter-heading">
              <h2 id={chapter.id + '-title'}>
                <span class="chapter-roman"><span class="sr-only">Chapter </span>{chapter.roman}</span>
                <span>{chapter.title}</span>
                {!secret && <span class="chapter-count">{chapter.quests.length} quests</span>}
              </h2>
            </summary>
            {secret ? <div class="chapter-secret"><p>Secret until release</p></div> : <>
              {info && <div class="chapter-info">
                <p>{info.purpose}</p>
                {info.machines.length > 0 && <p class="chapter-machines">
                  <strong>{info.machineSource ? `Machines using ${info.machineSource} include` : 'Machines include'}</strong>
                  <span>{info.machines.map(machine => machine.title).join(' · ')}</span>
                </p>}
              </div>}
              {chapter.quests.length > 0 && <ol class="questline" aria-label={chapter.title + ' quests'}>
                {chapter.quests.map(quest => {
                  const objective = quest.tasks.find(task => task.type !== 'checkmark');
                  const preview = objective && objectiveLabel(objective);
                  return (
                    <li class="quest-entry" id={'quest-' + quest.id} data-quest-id={quest.id}>
                      <details class="quest-detail">
                        <summary>
                          <span>{quest.title}</span>
                          {preview && preview !== quest.title && <span class="quest-preview">{preview}</span>}
                        </summary>
                        <div class="quest-body">
                          {quest.subtitle && quest.subtitle !== chapter.title && <p class="quest-subtitle">{quest.subtitle}</p>}
                          {quest.description.map(paragraph => <p>{paragraph}</p>)}
                          {quest.tasks.length > 0 && <>
                            <p class="quest-section-label">Objectives</p>
                            <ul aria-label="Objectives">
                              {quest.tasks.map(task => <li>{objectiveLabel(task)}</li>)}
                            </ul>
                          </>}
                          {quest.rewards && quest.rewards.length > 0 && <>
                            <p class="quest-section-label">Rewards</p>
                            <ul aria-label="Rewards">
                              {quest.rewards.map(reward => <li>{objectiveLabel(reward)}</li>)}
                            </ul>
                          </>}
                        </div>
                      </details>
                      {quest.prerequisites.length > 0 && <p class="quest-prerequisites">
                        <strong>{quest.dependencyRequirement === 'one_completed' ? 'Requires one of' : 'Requires'}</strong>
                        {' '}
                        {quest.prerequisites.map((prerequisite, index) => <>
                          {index > 0 && ' · '}
                          {prerequisite.chapterId ? <a href={'#quest-' + prerequisite.id}>{prerequisite.title}</a> :
                            <span>{prerequisite.title}{prerequisite.chapterTitle && ` (${prerequisite.chapterTitle})`}</span>}
                        </>)}
                      </p>}
                    </li>
                  );
                })}
              </ol>}
            </>}
          </details>
        </article>
      );
    })}
  </div>
</Layout>

<script>
  function revealChapter(hash: string) {
    const target = document.getElementById(hash.slice(1));
    const panel = target?.closest('[data-quest-chapter]')?.querySelector<HTMLDetailsElement>('.chapter-disclosure');
    if (!panel || panel.open) return;
    panel.open = true;
    return target;
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.chapter-jump, .quest-prerequisites a')) {
    link.addEventListener('click', () => revealChapter(link.hash));
  }

  function revealHash() {
    const target = revealChapter(location.hash);
    target?.scrollIntoView();
  }

  window.addEventListener('hashchange', revealHash);
  revealHash();
</script>

<style>
  .chapter-roadmap { margin: 24px 0 30px; }

  .chapter-jumps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .chapter-jumps li { display: flex; min-width: 0; margin: 0; }

  .chapter-jump {
    display: grid;
    grid-template-columns: 2em minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 54px;
    padding: 8px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 14px;
    font-weight: 550;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .chapter-jump:hover {
    background: var(--surface-raised);
    border-color: var(--control-border);
    text-decoration: none;
  }
  .chapter-jump-number { color: var(--gold-text); font-weight: 650; text-align: center; }

  .chapter-stages { display: grid; gap: 12px; }

  .chapter-stage {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .chapter-stage:target { border-color: var(--gold-text); }

  .chapter-heading {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 62px;
    padding: 10px 50px 10px 16px;
    border-radius: calc(var(--radius) - 1px);
    background: linear-gradient(#211813c9, #211813df), var(--chapter-spruce) 0 0 / 48px 48px repeat;
    color: #fff4e8;
    list-style: none;
  }

  .chapter-disclosure[open] > .chapter-heading {
    margin: 0;
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }
  .chapter-heading::-webkit-details-marker,
  .quest-detail > summary::-webkit-details-marker { display: none; }

  .chapter-heading::after, .quest-detail > summary::after {
    position: absolute;
    inset-inline-end: 22px;
    width: 8px;
    height: 8px;
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    content: '';
  }

  .chapter-disclosure[open] > .chapter-heading::after,
  .quest-detail[open] > summary::after { transform: translateY(2px) rotate(225deg); }

  .chapter-heading h2 {
    display: flex;
    flex: 1;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: clamp(17px, 2.25vw, 22px);
    line-height: 1.25;
    text-wrap: initial;
  }

  .chapter-roman { min-width: 2em; color: #ffda9e; font-size: .82em; text-align: center; }
  .chapter-count { margin-inline-start: auto; color: #eadacd; font-size: 13px; font-weight: 500; }

  .chapter-info {
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .chapter-info p { margin: 0; }
  .chapter-machines { color: var(--subtle); font-size: 14px; overflow-wrap: anywhere; }
  .chapter-machines strong { margin-inline-end: 8px; color: var(--text); font-weight: 600; }

  .questline { margin: 0; padding: 0 0 5px; list-style: none; }
  .quest-entry { margin: 0; padding: 0 18px; }
  .quest-entry + .quest-entry { border-top: 1px solid var(--border-soft); }
  .quest-entry:target { background: var(--accent-dark); }
  .quest-detail > summary {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 12px;
    min-height: 44px;
    padding: 7px 28px 7px 0;
    list-style: none;
    font-size: 16px;
    font-weight: 600;
  }
  .quest-detail > summary:hover { color: var(--accent); }
  .quest-detail[open] > summary { margin: 0; }
  .quest-detail > summary::after { inset-inline-end: 4px; width: 6px; height: 6px; color: var(--subtle); }
  .quest-preview { color: var(--subtle); font-size: 13px; font-weight: 450; }
  .quest-body { margin: 0 0 12px; color: var(--muted); }
  .quest-body p, .quest-body ul { margin: 0 0 6px; }
  .quest-body p { white-space: pre-line; }
  .quest-body li + li { margin-top: 2px; }
  .quest-subtitle { color: var(--subtle); font-size: 14px; }
  .quest-section-label { color: var(--text); font-size: 14px; font-weight: 600; }
  .quest-prerequisites { margin: -3px 23px 9px 0; color: var(--subtle); font-size: 13px; }
  .quest-prerequisites strong { color: var(--muted); font-weight: 560; }

  .chapter-secret {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 130px;
    place-items: center;
    overflow: hidden;
    background: #261b1c;
    border-radius: 0 0 calc(var(--radius) - 1px) calc(var(--radius) - 1px);
  }

  .chapter-secret::before, .chapter-secret::after {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 125%;
    height: 23px;
    background: repeating-linear-gradient(135deg, #aa2332 0 17px, #f3e5e4 17px 34px);
    border-block: 1px solid #693135;
    transform: translate(-50%, -50%) rotate(10deg);
    content: '';
  }
  .chapter-secret::after { transform: translate(-50%, -50%) rotate(-10deg); }
  .chapter-secret p {
    z-index: 1;
    margin: 12px;
    padding: 8px 14px;
    background: #261b1c;
    border: 1px solid #bd6873;
    border-radius: 5px;
    color: #fff2f2;
    font-size: 16px;
    font-weight: 650;
    text-align: center;
  }

  @media (min-width: 801px) and (max-width: 1210px), (max-width: 730px) {
    .chapter-jumps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 440px) {
    .chapter-jump { min-height: 48px; padding: 7px 8px; gap: 5px; }
    .chapter-heading { min-height: 54px; padding-inline: 10px 34px; }
    .chapter-heading::after { inset-inline-end: 15px; }
    .chapter-count { margin-inline-start: 0; }
    .chapter-info, .quest-entry { padding-inline: 12px; }
  }
</style>
