---
import Layout from '../layouts/Layout.astro';
import { data, href } from '../lib/data';

interface ChapterOutput {
  id: string;
  name: string;
}
interface Chapter {
  id: string;
  number: number;
  roman: string;
  title: string;
  mechanism: string;
  summary: string;
  milestones: ChapterOutput[];
}
interface Recipe extends ChapterOutput {
  chapter: number | null;
  output: string;
  outputKind: string;
  ingredients: { id: string }[];
}
type Texture = string | [number, number, number];
const chapterData: Chapter[] = data('chapters');
const recipes: Recipe[] = data('recipes');
const textures: Record<string, Texture> = data('recipe-textures', {});

const keyOutputs: Record<number, string> = {
  4: 'create:precision_mechanism',
  10: 'kubejs:creation_core',
};
const chapterExamples = [
  ['create:andesite_alloy'],
  ['kubejs:tk3_rotation_machine', 'create:deployer', 'create:mechanical_press'],
  ['kubejs:tk3_hydraulic_machine', 'create:fluid_tank', 'create:spout'],
  ['kubejs:tk3_precision_machine', 'create:mechanical_crafter', 'create:brass_funnel'],
  ['kubejs:calculation_machine', 'ae2:controller', 'createappliedkinetics:energy_provider'],
  ['kubejs:tk3_engineering_machine', 'immersiveengineering:capacitor_lv', 'immersiveengineering:dynamo'],
  ['kubejs:tk3_heavy_engineering_machine', 'createdieselgenerators:diesel_engine', 'immersiveengineering:component_electronic_adv'],
  ['create_wizardry:mana', 'kubejs:mana_tube', 'create_wizardry:mana_siphon'],
  ['kubejs:radiant_coil', 'kubejs:refined_shadow_alloy', 'create_riftborne:fluid_slipgate'],
  ['kubejs:unstable_creation_core', 'kubejs:matter_construct', 'kubejs:tk3_creation_machine'],
];

const stages = chapterData.map(chapter => {
  const chapterRecipes = recipes.filter(recipe => recipe.chapter === chapter.number);
  const key = chapterRecipes.find(recipe => recipe.output === (keyOutputs[chapter.number] ?? chapter.mechanism));
  const featured = (chapterExamples[chapter.number - 1] ?? []).flatMap(id => {
    const recipe = chapterRecipes.find(row => row.output === id);
    return recipe ? [recipe] : [];
  });
  const other = chapter.milestones.filter(item => item.id !== key?.output && !featured.some(recipe => recipe.output === item.id));
  return { ...chapter, key, featured, other, shortTitle: chapter.title.split(' · ')[0] };
});

function recipeHref(chapter: number, recipe?: Recipe) {
  return href(`recipes/?chapter=${chapter}${recipe ? '#recipe=' + encodeURIComponent(recipe.id) : '#recipe-results'}`);
}

function itemArt(recipe: Recipe) {
  const id = recipe.outputKind === 'fluid' ? 'fluid:' + recipe.output : recipe.output;
  const art = textures[id];
  if (typeof art === 'string') return { backgroundImage: `url("${href(art)}")` };
  if (!art) return null;
  const [atlas, column, row] = art;
  return {
    backgroundImage: `url("${href(`media/recipe-textures/items-${atlas}.webp`)}")`,
    backgroundSize: '1600% 1600%',
    backgroundPosition: `${column * 100 / 15}% ${row * 100 / 15}%`,
  };
}
const spruce = href('media/textures/spruce-planks.png');
---
<Layout title="Progression chapters" description="The Towns & Kingdoms roadmap, from the first workshop to advanced engineering, magic and the Creation Core.">
  <p class="eyebrow">Handbook / Progression</p>
  <h1>Progression chapters</h1>
  <p class="intro chapter-intro">Build your workshop from the first hand-crafted mechanism to the Creation Core. Each chapter shows its key recipe and what you can make along the way.</p>
  <p class="chapter-scope">Exploration and character development can continue alongside your workshop. Individual recipes list their required materials and machines.</p>

  <nav class="chapter-roadmap" aria-label="Jump to a chapter">
    <ol class="chapter-jumps">
      {stages.map(stage => <li>
        <a class="chapter-jump" href={'#' + stage.id} aria-label={`Chapter ${stage.roman}, ${stage.title}`}>
          <span class="chapter-jump-number">{stage.roman}</span>
          <span>{stage.shortTitle}</span>
        </a>
      </li>)}
    </ol>
  </nav>

  <div class="chapter-stages" style={{ '--chapter-spruce': `url("${spruce}")` }}>
    {stages.map(stage => {
      const keyArt = stage.key && itemArt(stage.key);
      const earlier = stages.filter(earlierStage =>
        earlierStage.number < stage.number && earlierStage.key &&
        stage.key?.ingredients.some(input => input.id === earlierStage.key?.output));
      return (
        <article class="chapter-stage" id={stage.id} aria-labelledby={stage.id + '-title'}>
          <header class="chapter-stage-heading">
            <span class="chapter-stage-number" aria-hidden="true">{stage.roman}</span>
            <div>
              <h2 id={stage.id + '-title'}><span class="sr-only">Chapter {stage.roman} · </span>{stage.title}</h2>
              <p class="chapter-summary">{stage.summary}</p>
            </div>
          </header>

          {stage.key && <div class="chapter-key">
            {keyArt && <span class="chapter-sprite chapter-key-sprite" aria-hidden="true" style={keyArt}></span>}
            <div>
              <p class="chapter-key-label">Key recipe</p>
              <h3>{stage.key.name}</h3>
              {earlier.length === 1 && <p class="chapter-key-link">Uses the <a href={'#' + earlier[0].id}>{earlier[0].key?.name}</a> from Chapter {earlier[0].roman}.</p>}
              {earlier.length > 1 && <p class="chapter-key-link">Uses mechanisms from Chapters {earlier.map((row, i) =>
                <>{i > 0 && ', '}<a href={'#' + row.id} aria-label={`Chapter ${row.roman}, ${row.key?.name}`}>{row.roman}</a></>
              )}.</p>}
            </div>
          </div>}

          {stage.featured.length > 0 && <div class="chapter-examples">
            <h3>Also in this chapter</h3>
            <ul>
              {stage.featured.map(recipe => {
                const art = itemArt(recipe);
                return <li><a href={recipeHref(stage.number, recipe)}>
                  {art && <span class="chapter-sprite chapter-example-sprite" aria-hidden="true" style={art}></span>}
                  <span>{recipe.name}</span>
                </a></li>;
              })}
            </ul>
          </div>}

          <div class="chapter-actions">
            {stage.key && <a class="button button-primary" href={recipeHref(stage.number, stage.key)} aria-label={`Open the ${stage.key.name} recipe`}>Open key recipe</a>}
            <a class="button" href={recipeHref(stage.number)} aria-label={`Browse recipes for Chapter ${stage.roman}`}>Browse chapter recipes</a>
          </div>

          {stage.other.length > 0 && <details class="chapter-more">
            <summary>More examples</summary>
            <ul>{stage.other.map(item => <li><a href={href('recipes/?q=' + encodeURIComponent(item.id))}>{item.name}</a></li>)}</ul>
          </details>}
        </article>
      );
    })}
  </div>
</Layout>

<style>
  .chapter-intro { margin-bottom: 10px; }

  .chapter-scope {
    max-width: 72ch;
    margin: 0;
    color: var(--subtle);
    font-size: 15px;
  }

  .chapter-roadmap { margin: 24px 0 34px; }

  .chapter-jumps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .chapter-jumps li { display: flex; min-width: 0; margin: 0; }

  .chapter-jump {
    display: grid;
    grid-template-columns: 2.1em minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 56px;
    padding: 8px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 14px;
    font-weight: 550;
    line-height: 1.25;
  }

  .chapter-jump:hover { background: var(--surface-raised); text-decoration: none; border-color: var(--control-border); }
  .chapter-jump-number { color: var(--gold-text); font-weight: 650; text-align: center; }

  .chapter-stages { display: grid; gap: 16px; }

  .chapter-stage {
    padding: clamp(16px, 2vw, 24px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .chapter-stage:target { border-color: var(--gold-text); }
  .chapter-stage-heading { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px; }

  .chapter-stage-number {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    background: var(--gold-surface);
    border: 1px solid var(--gold-border);
    border-radius: 6px;
    color: var(--gold-text);
    font-size: 17px;
    font-weight: 650;
  }

  .chapter-stage h2 { font-size: clamp(22px, 2.2vw, 30px); text-wrap: initial; margin: 0 0 5px; }
  .chapter-summary { color: var(--muted); margin: 0; }

  .chapter-key {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background-color: #271d17;
    background-image: linear-gradient(#211813c9, #211813db), var(--chapter-spruce);
    background-size: auto, 52px;
    border: 1px solid #665245;
    border-radius: 6px;
    color: #fff4e8;
  }

  .chapter-key h3 { font-size: 18px; margin: 0; }
  .chapter-key-label { margin: 0 0 1px; color: #efc286; font-size: 13px; font-weight: 600; }
  .chapter-key-link { margin: 4px 0 0; color: #eadacd; font-size: 14px; }
  .chapter-key-link a { color: #ffdcaa; text-decoration: underline; text-underline-offset: 3px; }
  .chapter-key-link a:focus-visible { outline-color: #ffdcaa; }

  .chapter-sprite {
    display: block;
    flex: 0 0 auto;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    image-rendering: pixelated;
  }

  .chapter-key-sprite { width: 48px; height: 48px; }
  .chapter-example-sprite { width: 24px; height: 24px; }
  .chapter-examples { margin-top: 16px; }
  .chapter-examples h3 { font-size: 15px; margin: 0 0 4px; }
  .chapter-examples ul, .chapter-more ul { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; padding: 0; list-style: none; }
  .chapter-examples li, .chapter-more li { margin: 0; }
  .chapter-examples a { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; font-size: 14px; }
  .chapter-more a { display: inline-block; padding: 4px 0; min-height: 34px; font-size: 14px; }

  .chapter-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 11.75rem)); gap: 8px; margin-top: 14px; }
  .chapter-actions .button { padding-inline: 8px; text-align: center; }
  .chapter-more { margin-top: 14px; border-top: 1px solid var(--border); }
  .chapter-more summary { min-height: 44px; padding-top: 10px; color: var(--muted); font-size: 14px; }
  .chapter-more[open] summary { margin-bottom: 4px; }
  .chapter-more ul { padding-bottom: 2px; }

  @media (min-width: 801px) and (max-width: 1180px), (max-width: 690px) {
    .chapter-jumps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 460px) {
    .chapter-jump { min-height: 48px; padding: 7px 8px; }
    .chapter-stage-heading { gap: 10px; }
    .chapter-stage-number { width: 36px; height: 36px; font-size: 15px; }
    .chapter-key { gap: 10px; padding: 12px; }
    .chapter-key-sprite { width: 36px; height: 36px; }
    .chapter-examples ul { gap: 0 14px; }
    .chapter-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chapter-actions .button { min-height: 48px; }
  }
</style>
