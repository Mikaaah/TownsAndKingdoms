---
import Layout from '../layouts/Layout.astro';
import { data, href } from '../lib/data';
const installed = data('mods');
/*
 * The title images are web-optimized copies of the heading PNGs published in
 * each project's CurseForge description. Original i.imgur.com PNG IDs:
 * Progression lGbam9k, Unidentified Loot Bhs9vCA, Workshop fHpgPO1,
 * Alchemical Lasers q7nqwEG, Wildshape 0yL04dQ, Flow Control snkajeD,
 * Combat Punchy lEM9qy3, Combat Afloat RxiYjzR, Resonant Arcana 2FIsYgK.
 */
const definitions=[
 {projectId:1789363,id:'progression',title:'Towns & Kingdoms — Progression',category:'Character & rewards',summary:'Connects character experience, levels, Origins, titles and skill points into the pack’s character systems.',details:['Ordinary activities and combat contribute to character growth.','Origins and Ascended Origins provide background choices and conditional perks.','Enemy scaling and character rules sit alongside the equipment systems.'],link:'mechanics/#leveling',label:'Read the character reference'},
 {projectId:1753149,id:'unidentified-loot',title:'Unidentified Loot — Towns & Kingdoms',category:'Character & rewards',summary:'Turns equipment discoveries into an appraisal loop, with unidentified rewards, rarity rolls, affixes and salvage.',details:['Identify a reward before deciding whether it belongs in your build.','Equipment tier and rarity have separate roles in the reward rules.','The Mechanical Identifier connects appraisal to Create processing.'],link:'loot/',label:'Understand appraisal & salvage'},
 {projectId:1789377,id:'workshop',title:'Towns & Kingdoms — Workshop',category:'Factory & world',summary:'Provides pack-specific tools and shared-world integrations, including the public Trading Hub directory.',details:['Helps connect a server’s public trading locations.','Houses workshop and presentation tools used by the pack.','Server-configured community features complement the individual workshop.'],link:'guides/player-shops/',label:'Player shop guide'},
 {projectId:1787221,id:'alchemical-lasers',title:'Create — Alchemical Lasers',category:'Factory & world',summary:'Adds rotation-powered laser processing to Create production lines, using emitters, lenses and custom transformation recipes.',details:['Choose a lens to control the kind of processing a line performs.','Integrate laser processing with the pack’s material recipes.','Automate inputs and outputs alongside the rest of the factory.'],link:'recipes/?q=alchemicallaser',label:'Find laser recipes'},
 {projectId:1792816,id:'wildshape',title:'Towns & Kingdoms — Wildshape',category:'Factory & world',summary:'Shapes the Overworld with broad terrain, connected caverns and configurable world-generation presets.',details:['Provides landforms with room for settlements and exploration.','Includes terrain and structure safeguards for a modded world.','Works with the pack’s selected biome and river systems.'],link:'features/#adventure',label:'Explore the adventure systems'},
 {projectId:1750740,id:'flow-control',title:'Flow Control',category:'Factory & world',summary:'Adds tools for controlling Streams Reflowing currents around waterways, docks and other builds.',details:['Direct currents where a build needs a particular flow.','Create calmer water around docks and moorings.','Manage local flow without replacing the landscape around it.'],link:'mods/',label:'Find the river integrations'},
 {projectId:1779010,id:'combat-punchy',title:'Combat Punchy',category:'Combat & magic',summary:'Coordinates Epic Fight combat with Punchy and Punchy!Moves animations as you move between fighting and everyday tasks.',details:['Attacking with an eligible weapon or receiving a sourced hit can enter combat mode.','Selecting a tool or leaving combat activity returns control to everyday handling.','The configured timeout is seven seconds; visual back weapons remain a cosmetic display.'],link:'guides/epic-fight/#combat-mode',label:'Learn automatic combat switching'},
 {projectId:1793786,id:'combat-afloat',title:'Combat Afloat',category:'Combat & magic',summary:'Connects Epic Fight interactions with Sable ships and Create Aeronautics contraptions.',details:['Adjusts combat positioning for moving ship surfaces.','Handles deck landings and Meteor Slam interactions.','Adds protections for ship blocks around supported combat effects.'],link:'features/#moving-machines',label:'Explore moving machines'},
 {projectId:1750997,id:'resonant-arcana',title:'Resonant Arcana',category:'Combat & magic',summary:'Expands Iron’s Spells ’n Spellbooks with additional spells, spellbooks and powerful ritual magic.',details:['Uses Iron’s native spellcasting, mana and spell-school systems.','Adds options for offense, defense, movement and battlefield control.','Supported content integrations contribute boss- and environment-themed magic.'],link:'mods/',label:'Find the magic ecosystem'},
];
const mods=definitions.map(entry=>({...entry,mod:installed.find((mod:any)=>mod.projectId===entry.projectId)})).filter(entry=>entry.mod);
const categories=['Character & rewards','Factory & world','Combat & magic'];
---
<Layout title="Custom mods" description="The Towns & Kingdoms mods and integrations behind character growth, equipment appraisal, factory processing and world systems.">
 <p class="eyebrow">Reference</p>
 <h1>Custom mods</h1>
 <p class="intro">Explore the mods behind character progression, equipment appraisal, player shops and the pack’s custom integrations.</p>
 <nav class="toc-inline" aria-label="Custom mod categories">
  {categories.map((category, i) => <a href={`#custom-domain-${i}`}>{category}</a>)}
 </nav>

 {categories.map((category, i) => (
  <section class="section custom-domain" id={`custom-domain-${i}`}>
   <div class="section-heading"><h2>{category}</h2></div>
   <div class="custom-mod-list">
    {mods.filter(entry => entry.category === category).map(entry => (
     <article class="custom-mod" id={entry.id} aria-labelledby={`title-${entry.id}`}>
      <h3 id={`title-${entry.id}`}>
       <span class="sr-only">{entry.title}</span>
       <img class="mod-title-art" src={href(`media/custom-mods/${entry.id}.webp`)} alt=""
        width="1456" height="250" loading={i === 0 ? 'eager' : 'lazy'} decoding="async">
      </h3>
      <div class="custom-mod-content">
       <p>{entry.summary}</p>
       <ul>{entry.details.map(detail => <li>{detail}</li>)}</ul>
       <div class="custom-mod-links">
        <a href={href(entry.link)}>{entry.label}</a>
        <a href={entry.mod.url} target="_blank" rel="noopener">CurseForge</a>
        <a href={href('mods/#mod=' + encodeURIComponent(entry.mod.id))}>Mod index</a>
       </div>
      </div>
     </article>
    ))}
   </div>
  </section>
 ))}

 <div class="callout section">
  <p>Browse the <a href={href('mods/')}>complete mod index</a> or visit <a href={href('support/')}>support</a> for help installing the pack.</p>
 </div>
</Layout>

<style>
 .custom-domain { padding-top: 1.25rem; border-top: 1px solid var(--border); }
 .custom-mod-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
 .custom-mod {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  scroll-margin-top: calc(var(--header-height) + 1rem);
 }
 .custom-mod h3 { position: relative; margin: 0; }
 .mod-title-art { display: block; width: 100%; min-height: 4.5rem; height: auto; object-fit: cover; }
 .custom-mod-content { display: flex; flex: 1; flex-direction: column; padding: 1.25rem; }
 .custom-mod-content p { margin: 0; line-height: 1.65; }
 .custom-mod ul { margin: .75rem 0 1rem; padding-left: 1.2rem; color: var(--muted); line-height: 1.6; }
 .custom-mod li + li { margin-top: .25rem; }
 .custom-mod li::marker { color: var(--accent); }
 .custom-mod-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 .9rem;
  margin-top: auto;
  padding-top: .4rem;
  border-top: 1px solid var(--border-soft);
  font-size: .875rem;
 }
 .custom-mod-links a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 550; }
 .custom-mod-links a:not(:first-child) { color: var(--muted); }
 .callout p { margin: 0; }
 @media (max-width: 1080px) {
  .custom-mod-list { grid-template-columns: minmax(0, 1fr); }
 }
 @media (max-width: 520px) {
  .custom-mod-content { padding: 1rem; }
 }
</style>
