---
import Layout from '../layouts/Layout.astro';
import QuestIcon from '../components/QuestIcon.astro';
import { data, href } from '../lib/data';
const installed=data('mods');
const definitions=[
 {projectId:1789363,id:'progression',title:'Towns & Kingdoms — Progression',category:'Character & rewards',icon:'skill_point',summary:'Connects character experience, levels, Origins, titles and skill points into the pack’s character systems.',details:['Ordinary activities and combat contribute to character growth.','Origins and Ascended Origins provide background choices and conditional perks.','Enemy scaling and character rules sit alongside the equipment systems.'],link:'mechanics/#leveling',label:'Read the character reference'},
 {projectId:1753149,id:'unidentified-loot',title:'Unidentified Loot — Towns & Kingdoms',category:'Character & rewards',icon:'satchel',summary:'Turns equipment discoveries into an appraisal loop, with unidentified rewards, rarity rolls, affixes and salvage.',details:['Identify a reward before deciding whether it belongs in your build.','Equipment tier and rarity have separate roles in the reward rules.','The Mechanical Identifier connects appraisal to Create processing.'],link:'loot/',label:'Understand appraisal & salvage'},
 {projectId:1789377,id:'workshop',title:'Towns & Kingdoms — Workshop',category:'Factory & world',icon:'rotation_mechanism',summary:'Provides pack-specific tools and shared-world integrations, including the public Trading Hub directory.',details:['Helps connect a server’s public trading locations.','Houses workshop and presentation tools used by the pack.','Server-configured community features complement the individual workshop.'],link:'mods/',label:'Browse the mod index'},
 {projectId:1787221,id:'alchemical-lasers',title:'Create — Alchemical Lasers',category:'Factory & world',icon:'mirror',summary:'Adds rotation-powered laser processing to Create production lines, using emitters, lenses and custom transformation recipes.',details:['Choose a lens to control the kind of processing a line performs.','Integrate laser processing with the pack’s material recipes.','Automate inputs and outputs alongside the rest of the factory.'],link:'recipes/?q=alchemicallaser',label:'Find laser recipes'},
 {projectId:1792816,id:'wildshape',title:'Towns & Kingdoms — Wildshape',category:'Factory & world',icon:'map',summary:'Shapes the Overworld with broad terrain, connected caverns and configurable world-generation presets.',details:['Provides landforms with room for settlements and exploration.','Includes terrain and structure safeguards for a modded world.','Works with the pack’s selected biome and river systems.'],link:'features/#adventure',label:'Explore the adventure systems'},
 {projectId:1750740,id:'flow-control',title:'Flow Control',category:'Factory & world',icon:'potionblue',summary:'Adds tools for controlling Streams Reflowing currents around waterways, docks and other builds.',details:['Direct currents where a build needs a particular flow.','Create calmer water around docks and moorings.','Manage local flow without replacing the landscape around it.'],link:'mods/',label:'Find the river integrations'},
 {projectId:1779010,id:'combat-punchy',title:'Combat Punchy',category:'Combat & magic',icon:'hammer',summary:'Coordinates Epic Fight combat with Punchy and Punchy!Moves animations as you move between fighting and everyday tasks.',details:['Attacking with an eligible weapon or receiving a sourced hit can enter combat mode.','Selecting a tool or leaving combat activity returns control to everyday handling.','The configured timeout is seven seconds; visual back weapons remain a cosmetic display.'],link:'guides/#combat',label:'Learn weapon handling'},
 {projectId:1793786,id:'combat-afloat',title:'Combat Afloat',category:'Combat & magic',icon:'rope',summary:'Connects Epic Fight interactions with Sable ships and Create Aeronautics contraptions.',details:['Adjusts combat positioning for moving ship surfaces.','Handles deck landings and Meteor Slam interactions.','Adds protections for ship blocks around supported combat effects.'],link:'features/#moving-machines',label:'Explore moving machines'},
 {projectId:1750997,id:'resonant-arcana',title:'Resonant Arcana',category:'Combat & magic',icon:'bookred',summary:'Expands Iron’s Spells ’n Spellbooks with additional spells, spellbooks and powerful ritual magic.',details:['Uses Iron’s native spellcasting, mana and spell-school systems.','Adds options for offense, defense, movement and battlefield control.','Supported content integrations contribute boss- and environment-themed magic.'],link:'mods/',label:'Find the magic ecosystem'},
];
const mods=definitions.map(entry=>({...entry,mod:installed.find((mod:any)=>mod.projectId===entry.projectId)})).filter(entry=>entry.mod);
const categories=['Character & rewards','Factory & world','Combat & magic'];
---
<Layout title="Custom mods" description="The Towns & Kingdoms mods and integrations behind character growth, equipment appraisal, factory processing and world systems.">
 <p class="eyebrow">Reference / Custom mods</p><h1>Built for Towns & Kingdoms.</h1><p class="intro">These mods and integrations connect the pack’s character, factory and exploration systems. Each has a specific role, from appraising a dungeon reward to coordinating combat on a moving ship.</p>
 <nav class="toc-inline" aria-label="Custom mod categories">{categories.map((category,i)=><a href={'#custom-domain-'+i}>{category}</a>)}</nav>
 {categories.map((category,i)=><section class="section custom-domain" id={'custom-domain-'+i}><div class="section-heading"><h2>{category}</h2><span class="tag">{mods.filter(mod=>mod.category===category).length} mods</span></div><div class="custom-mod-list">{mods.filter(mod=>mod.category===category).map(entry=><article class="custom-mod" id={entry.id}><div class="custom-mod-heading"><span class="card-icon"><QuestIcon name={entry.icon} size={25} /></span><div><h3>{entry.title}</h3><p>{entry.summary}</p></div></div><ul>{entry.details.map(detail=><li>{detail}</li>)}</ul><div class="custom-mod-links"><a href={href(entry.link)}>{entry.label} →</a><a href={entry.mod.url} target="_blank" rel="noopener">Official mod page</a><a href={href('mods/#mod='+encodeURIComponent(entry.mod.id))}>View in mod index</a></div></article>)}</div></section>)}
 <div class="callout section"><strong>Part of a wider modpack.</strong><p>These integrations work alongside the systems in the <a href={href('mods/')}>complete grouped mod index</a>. For installation and troubleshooting, use <a href={href('support/')}>support</a> rather than mixing individual mod downloads into an existing instance.</p></div>
</Layout>
<style>
.custom-domain{padding-top:20px;border-top:1px solid var(--border)}.custom-mod-list{display:grid;gap:16px}.custom-mod{padding:24px;border:1px solid var(--border);background:var(--surface);border-radius:8px;scroll-margin-top:95px}.custom-mod-heading{display:flex;align-items:flex-start;gap:16px}.custom-mod-heading .card-icon{flex-shrink:0;margin-top:2px}.custom-mod-heading h3{margin:0 0 10px;font-size:19px}.custom-mod-heading p{margin:0;color:var(--muted);font-size:16px;line-height:1.9;max-width:770px}.custom-mod ul{margin:17px 0 20px 47px;padding-left:18px;color:var(--muted);font-size:16px;line-height:1.8}.custom-mod-links{display:flex;flex-wrap:wrap;gap:18px;padding-top:17px;border-top:1px solid var(--border-soft);font-size:14px}.custom-mod-links a:not(:first-child){color:var(--muted)}@media(max-width:520px){.custom-mod{padding:19px}.custom-mod-heading{gap:12px}.custom-mod-heading h3{font-size:17px}.custom-mod ul{margin-left:0}.custom-mod-links{gap:12px;font-size:14px}}
</style>
