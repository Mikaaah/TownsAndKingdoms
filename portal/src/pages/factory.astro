---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/data';
import { MAX_FACTORY_AMOUNT } from '../lib/factory-plan.mjs';
---
<Layout title="Factory planner" description="Build a production plan from Towns & Kingdoms recipes. Choose a target, compare recipes, and total the supplies." wide>
  <p class="eyebrow">Tools / Production</p>
  <h1>Factory planner</h1>
  <p class="intro">Choose what to make and how many you need. Follow each recipe back to the items and fluids you’ll supply.</p>

  <div class="factory" data-factory data-base={href()} style={{ '--flow-arrow': `url("${href('media/quest-ui/down.png')}")` }}>
    <section class="factory-controls" aria-label="Plan settings">
      <form data-target-form>
        <div class="factory-picker" data-picker>
          <label for="factory-product">Product</label>
          <input id="factory-product" type="search" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="factory-products" placeholder="Search for an item or fluid" data-picker-input autocomplete="off" spellcheck="false" required disabled />
          <ul id="factory-products" role="listbox" aria-label="Matching products" data-picker-options hidden></ul>
        </div>
        <div class="factory-amount">
          <label for="factory-amount" data-amount-label>Quantity</label>
          <input id="factory-amount" name="amount" type="number" min="1" max={MAX_FACTORY_AMOUNT} step="1" value="1" required disabled />
        </div>
        <button type="submit" class="button button-primary" disabled>Plan production</button>
      </form>
      <form data-stock-form>
        <div class="factory-picker" data-picker>
          <label for="factory-stock">Supplied ingredients <span>Optional</span></label>
          <input id="factory-stock" type="search" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="factory-stock-options" aria-describedby="factory-stock-help" placeholder="Search for an ingredient you already have" data-picker-input autocomplete="off" spellcheck="false" required disabled />
          <ul id="factory-stock-options" role="listbox" aria-label="Matching ingredients" data-picker-options hidden></ul>
        </div>
        <button type="submit" disabled>Add ingredient</button>
      </form>
      <p id="factory-stock-help">Planning stops at any ingredient you add here.</p>
      <ul class="factory-stock-list" data-stock-list aria-label="Supplied ingredients" hidden></ul>
    </section>

    <p class="factory-message" data-factory-message role="status">Loading the recipe index…</p>
    <p class="sr-only" data-plan-announcement role="status"></p>
    <noscript><p>Enable JavaScript to make a production plan, or browse the <a href={href('recipes/')}>recipe reference</a>.</p></noscript>

    <div data-factory-results hidden>
      <header class="factory-summary">
        <div class="factory-target">
          <span class="factory-target-icon" data-target-icon aria-hidden="true"></span>
          <div>
            <h2 data-plan-title>Production plan</h2>
            <p data-plan-detail></p>
          </div>
        </div>
        <div class="factory-share">
          <button type="button" data-copy-plan>Copy plan link</button>
          <span data-copy-status role="status"></span>
        </div>
      </header>

      <div class="factory-workspace">
        <section aria-labelledby="factory-flow-title" class="factory-flow">
          <h3 id="factory-flow-title">Production flow</h3>
          <p class="factory-order">Start at the top and work toward the finished product.</p>
          <ol class="factory-steps" data-plan-steps></ol>
        </section>
        <aside class="factory-totals" aria-label="Plan totals">
          <section class="factory-total" data-materials-section>
            <h3>Required supplies</h3>
            <ul class="factory-resources" data-plan-materials></ul>
          </section>
          <section class="factory-total" data-catalysts-section hidden>
            <h3>Reusable materials</h3>
            <ul class="factory-resources" data-plan-catalysts></ul>
          </section>
          <section class="factory-total" data-processes-section hidden>
            <h3>Operations</h3>
            <ul class="factory-resources" data-plan-processes></ul>
          </section>
          <section class="factory-total" data-extras-section hidden>
            <h3>Extra outputs</h3>
            <ul class="factory-resources" data-plan-extras></ul>
          </section>
          <section class="factory-total" data-issues-section hidden>
            <h3>Check this plan</h3>
            <ul class="factory-issues" data-plan-issues></ul>
          </section>
        </aside>
      </div>
      <p class="factory-note">Runs are whole recipe batches. Extra outputs are tracked separately. Check JEI for supply options and recipes outside the handbook.</p>
    </div>
  </div>
  <script>import '../scripts/factory.js';</script>
</Layout>
<style>
  .factory { display:grid; gap:1.5rem }
  .factory-controls {
    display:grid; gap:1rem; padding:clamp(1rem,2.3vw,1.45rem);
    border:1px solid var(--border); border-top:2px solid var(--gold-border);
    border-radius:var(--radius); background:var(--surface)
  }
  .factory-controls form { display:grid; grid-template-columns:minmax(0,1fr) minmax(7rem,11rem) auto; align-items:end; gap:.75rem; margin:0 }
  .factory-controls form + form { grid-template-columns:minmax(0,1fr) auto; padding-top:1rem; border-top:1px solid var(--border) }
  .factory-controls label { display:block; margin-bottom:.25rem; color:var(--text); font-weight:600; font-size:.92rem }
  .factory-controls label span { color:var(--subtle); font-weight:400; margin-inline-start:.35rem }
  .factory-controls input { display:block; width:100%; min-height:46px }
  .factory-controls button { min-height:46px; white-space:nowrap }
  .factory-controls > p { margin:-.55rem 0 0; color:var(--subtle); font-size:.875rem }
  .factory-picker { position:relative; min-width:0 }
  .factory-picker ul {
    position:absolute; z-index:4; inset-inline:0; top:100%; margin:.375rem 0 0; padding:.25rem;
    list-style:none; max-height:19rem; overflow:auto;
    border:1px solid var(--control-border); border-radius:6px; background:var(--bg); box-shadow:0 12px 28px #0005
  }
  .factory-picker :global(li) { margin:0 }
  .factory-picker :global(.factory-no-match) { padding:.55rem .65rem; color:var(--subtle) }
  .factory-picker :global([role=option]) {
    cursor:pointer; padding:.5rem .65rem; min-height:44px; display:flex; gap:.625rem; align-items:center;
    border-radius:4px; line-height:1.3; overflow-wrap:anywhere
  }
  .factory-picker :global([role=option]:hover), .factory-picker :global([aria-selected=true]) { background:var(--surface-raised) }
  .factory-picker :global([role=option] small) { display:block; color:var(--subtle); font-size:.8rem; margin-top:.15rem }
  .factory-stock-list { display:flex; flex-wrap:wrap; gap:.45rem; margin:0; padding:0; list-style:none }
  .factory-stock-list :global(li) { margin:0 }
  .factory-stock-list :global(button) {
    display:flex; align-items:center; gap:.5rem; min-height:40px; padding:.35rem .65rem; background:var(--bg);
    white-space:normal; text-align:left; font-size:.875rem
  }
  .factory-stock-list :global(.factory-remove) { color:var(--subtle); font-size:1.1rem }
  .factory-message, .factory-note { color:var(--subtle); font-size:.9rem; margin:0 }
  .factory-summary { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.3rem }
  .factory-target { display:flex; gap:.8rem; align-items:center; min-width:0 }
  .factory-target-icon {
    display:grid; place-items:center; width:3.1rem; height:3.1rem; flex:none; border:1px solid var(--gold-border);
    border-radius:8px; background:var(--gold-surface)
  }
  .factory-target-icon :global(.factory-art) { width:1.9rem; height:1.9rem }
  .factory-summary h2 { font-size:clamp(1.25rem,2.4vw,1.65rem); margin:0; overflow-wrap:anywhere }
  .factory-summary p { color:var(--muted); font-size:.9rem; margin:0 }
  .factory-share { display:flex; flex-direction:column; align-items:flex-start; gap:.2rem }
  .factory-share button { font-size:.9rem }
  .factory-share span { font-size:.85rem; color:var(--subtle) }
  .factory-workspace { display:grid; grid-template-columns:minmax(0,2.1fr) minmax(15rem,1fr); gap:1.35rem }
  .factory-flow h3,.factory-totals h3 { margin:0; font-size:1.1rem }
  .factory-order { color:var(--subtle); font-size:.9rem; margin:.15rem 0 .8rem }
  .factory-steps { display:grid; gap:1.3rem; list-style:none; padding:0; margin:0 }
  .factory-steps :global(.factory-step) {
    position:relative; display:grid; grid-template-columns:1.05fr 1fr .9fr; align-items:start;
    border:1px solid var(--border); border-radius:8px; background:var(--surface);
    gap:.75rem; padding:.8rem .85rem; min-width:0; margin:0;
    scroll-margin-top:calc(var(--header-height) + 1rem)
  }
  .factory-steps :global(.factory-step:target) { border-color:var(--gold-border) }
  .factory-steps :global(.factory-step + .factory-step::before) {
    content:''; width:1rem; height:1rem; background:var(--flow-arrow) center / contain no-repeat;
    position:absolute; top:-1.19rem; left:50%; transform:translateX(-50%); image-rendering:pixelated
  }
  .factory-steps :global(.factory-side) { min-width:0 }
  .factory-steps :global(.factory-side + .factory-side) { border-left:1px solid var(--border); padding-left:.75rem }
  .factory-steps :global(.factory-side-heading) {
    display:block; margin-bottom:.4rem; color:var(--subtle); font-size:.77rem;
    font-weight:600; letter-spacing:.03em; text-transform:uppercase
  }
  .factory-steps :global(.factory-result .factory-item-name) { font-weight:650; color:var(--gold-text) }
  .factory-steps :global(p) { margin:0; color:var(--subtle); font-size:.85rem; line-height:1.45 }
  .factory-steps :global(.factory-recipe-name) { color:var(--text); font-size:.94rem; font-weight:600; line-height:1.35 }
  .factory-steps :global(.factory-recipe-meta) { margin:.3rem 0 0 }
  .factory-steps :global(.factory-recipe-link) { display:inline-flex; align-items:center; min-height:44px; font-size:.86rem }
  .factory-steps :global(select) { width:100%; min-height:44px; padding:.35rem 1.7rem .35rem .45rem; font-size:.83rem }
  .factory-steps :global(.factory-choice + .factory-choice) { margin-top:.3rem }
  .factory-steps :global(.factory-selection) { display:block; margin-top:.3rem }
  .factory-steps :global(.factory-byproducts) { margin-top:.55rem }
  .factory-steps :global(.factory-flow-empty) {
    padding:1rem; margin:0; border:1px dashed var(--border);
    border-radius:8px; color:var(--muted); font-size:.95rem
  }
  .factory-totals { display:grid; align-content:start; gap:.8rem }
  .factory-total { padding:.85rem .92rem; background:var(--surface); border:1px solid var(--border); border-radius:8px; min-width:0 }
  .factory-total h3 { margin-bottom:.45rem }
  .factory-total :global(.factory-resource + .factory-resource) { border-top:1px solid var(--border); padding-top:.45rem; margin-top:.45rem }
  .factory :global(.factory-resources), .factory-issues { display:grid; gap:.35rem; list-style:none; margin:0; padding:0 }
  .factory :global(.factory-resource), .factory-issues :global(li) { margin:0; min-width:0 }
  .factory :global(.factory-item) { display:flex; align-items:center; gap:.42rem; min-width:0; font-size:.87rem; line-height:1.4 }
  .factory :global(.factory-item-name) { flex:1; min-width:0; color:var(--text); overflow-wrap:anywhere }
  .factory :global(.factory-quantity) { margin-inline-start:auto; font-variant-numeric:tabular-nums; color:var(--gold-text); text-align:right; flex:none }
  .factory :global(.factory-item-note) { display:block; margin:.16rem 0 0; color:var(--subtle); font-size:.79rem; line-height:1.35 }
  .factory :global(.factory-art) {
    width:1.2rem; height:1.2rem; flex:none; display:inline-block; object-fit:contain; image-rendering:pixelated;
    background-repeat:no-repeat; background-size:1600% 1600%
  }
  .factory-issues { color:var(--muted); font-size:.89rem; line-height:1.45 }
  .factory-note { margin-top:1.2rem }

  @media(max-width:1200px) and (min-width:801px), (max-width:800px) {
    .factory-workspace { grid-template-columns:minmax(0,1fr) }
    .factory-totals { grid-row:1; grid-template-columns:repeat(auto-fit,minmax(min(15rem,100%),1fr)) }
  }
  @media(max-width:565px) {
    .factory-controls form { grid-template-columns:minmax(0,1fr) minmax(6rem,auto) }
    .factory-controls form:first-of-type .factory-picker { grid-column:1/-1 }
    .factory-controls form + form { grid-template-columns:minmax(0,1fr) }
    .factory-controls form + form button { justify-self:start }
    .factory-steps :global(.factory-step) { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:.6rem .8rem }
    .factory-steps :global(.factory-step .factory-operation) { border:0; padding:0; grid-column:1/-1; order:-1; padding-bottom:.6rem; border-bottom:1px solid var(--border) }
  }
</style>
