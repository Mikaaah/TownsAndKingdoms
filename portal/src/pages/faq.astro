---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/data';

const topics = [
  {
    id: 'getting-started',
    title: 'Getting started',
    questions: [
      {
        id: 'installation',
        question: 'Which version do I install?',
        answer: 'Look for Towns & Kingdoms 3: Beyond the Forge, then import it as a separate launcher instance. It runs on Minecraft 1.21.1 with NeoForge. For multiplayer, use the exact pack release the server asks for.',
      },
      {
        id: 'first-world',
        question: 'What should I do after spawning?',
        answer: 'Set up a bed, food and storage, then open the quest book and start Chapter I. If you want a first workshop goal, work toward a Rotation Mechanism and follow its ingredients back from the recipe.',
        link: { label: 'Your first evening', path: 'guides/#first-steps' },
      },
      {
        id: 'java',
        question: 'Which Java should my launcher use?',
        answer: 'Select 64-bit Java 21 in the Minecraft instance settings. For a dedicated server, check the Java selected by your host panel or startup script.',
        link: { label: 'Dedicated server setup', path: 'guides/server-setup/' },
      },
      {
        id: 'memory',
        question: 'How much RAM should I give the pack?',
        answer: 'Start with an 8 GB Java heap for the client if your PC has enough memory left for its operating system and other apps. The setting is usually under Java or Memory in your launcher.',
      },
    ],
  },
  {
    id: 'playing-together',
    title: 'Playing together',
    questions: [
      {
        id: 'official-servers',
        question: 'How do I join the official server?',
        answer: 'Select Official Server on the Minecraft main menu. It takes you to the hub, where you can choose the EU or US server.',
        link: { label: 'Official servers and rules', path: 'servers/#joining' },
      },
      {
        id: 'public-servers',
        question: 'Where can I find other public worlds?',
        answer: 'Open Multiplayer and look for the BisectHosting public server list. Check each server’s description and rules before joining.',
        link: { label: 'Find a public server', path: 'servers/#public-servers' },
      },
      {
        id: 'multiplayer',
        question: 'Why can’t I join my friend’s server?',
        answer: 'Compare the full pack version with the host and read the disconnect message. A missing-mod or registry error points to an installation mismatch. If the connection times out, ask the host whether the server is running and check the address and port.',
        link: { label: 'Server connection help', path: 'servers/#connection-help' },
      },
      {
        id: 'shops',
        question: 'How do I set up a shop other players can visit?',
        answer: 'Set up the sale using Create’s shop system. Use the Shop Teleporter, called the Trading Hub in-game, to list a destination that takes other players to your shop.',
        link: { label: 'Build and list a player shop', path: 'guides/player-shops/' },
      },
    ],
  },
  {
    id: 'progression-and-gear',
    title: 'Progression and gear',
    questions: [
      {
        id: 'progression',
        question: 'Can I explore before finishing the factory chapters?',
        answer: 'Yes. The chapters guide your factory upgrades. You can explore dimensions and summon the Wither as soon as you meet their usual entry or summoning requirements. The End uses End Remastered’s eyes.',
        link: { label: 'Progression chapters', path: 'chapters/' },
      },
      {
        id: 'end-portal',
        question: 'Which eyes do I need for the End portal?',
        answer: 'Defeat any twelve of the sixteen bosses in the eye guide, then place their twelve different End Remastered eyes in the Stronghold portal frames.',
        link: { label: 'Find each eye’s boss', path: 'bosses/#eye-routes' },
      },
      {
        id: 'recipes',
        question: 'Where do I find the pack’s recipe for an item?',
        answer: 'Hover over the item in JEI and press R with the default keybind. Check the recipe tabs for the right machine or assembly. In the handbook, search by the item name or registry ID to see the process and inputs.',
        link: { label: 'Browse recipes', path: 'recipes/' },
      },
      {
        id: 'skills',
        question: 'Why can’t I unlock this skill yet?',
        answer: 'Check the node’s point cost, its connection to an unlocked skill and any minimum points already spent. In the web planner, choose Plan route and select a node to see the shortest unlock path and its cost.',
        link: { label: 'Open the skilltree planner', path: 'skills/' },
      },
      {
        id: 'loot',
        question: 'What do I do with unidentified gear?',
        answer: 'Take it to an Identifier to preview its reward pool and reveal the item using vanilla XP. If you use a Mechanical Identifier, supply fluid XP. You can salvage unwanted gear for fragments.',
        link: { label: 'Check appraisal costs', path: 'loot/' },
      },
      {
        id: 'tiers',
        question: 'Does higher rarity always mean better gear?',
        answer: 'Compare the revealed affixes with what your build needs. A boosted stat helps most when it supports the attacks, spells or defenses you actually use.',
        link: { label: 'Read about loot and rarity', path: 'loot/' },
      },
      {
        id: 'staffs',
        question: 'How can I tell how a weapon handles in Fight Mode?',
        answer: 'Find the weapon in the registry and check its style and grip. Try its regular combo and innate skill in a safe area before taking it into a boss fight.',
        link: { label: 'Browse weapon styles', path: 'weapons/' },
      },
    ],
  },
  {
    id: 'troubleshooting',
    title: 'Troubleshooting',
    questions: [
      {
        id: 'shaders',
        question: 'What should I try if shaders make the world look wrong?',
        answer: 'Turn the shader pack off and load the same area again. TNK3 includes Iris, Sodium and Flywheel compatibility. If the issue happens only with shaders enabled, include the shader pack name and preset when you report it.',
        link: { label: 'Get help with a visual issue', path: 'support/' },
      },
      {
        id: 'updates',
        question: 'How do I update without risking my world?',
        answer: 'Back up your world and its configuration before following the release’s update instructions. For multiplayer, update the server and client to the matching release, then test with one player before reopening the server.',
      },
      {
        id: 'loading',
        question: 'What should I share if startup stalls or the game crashes?',
        answer: 'Attach the full latest.log and the newest crash report if one exists. Include the pack version and describe when the issue happens, such as before the main menu, while joining or after the world loads.',
        link: { label: 'Find the right logs', path: 'support/#logs' },
      },
    ],
  },
];
---

<Layout title="Frequently asked questions" description="Get help with starting Towns & Kingdoms 3, finding a server, building a shop and using the pack’s progression systems.">
  <p class="eyebrow">Handbook / Help</p>
  <h1>Frequently asked questions</h1>
  <nav class="toc-inline" aria-label="FAQ topics">
    {topics.map(({ id, title }) => <a href={'#' + id}>{title}</a>)}
  </nav>

  <div class="faq-topics">
    {topics.map(({ id, title, questions }) => (
      <section id={id} aria-labelledby={id + '-title'}>
        <h2 id={id + '-title'}>{title}</h2>
        <div class="faq-questions">
          {questions.map(({ id: questionId, question, answer, link }) => (
            <details id={questionId}>
              <summary>{question}</summary>
              <p>{answer}</p>
              {link && <a class="faq-reference" href={href(link.path)}>{link.label}</a>}
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    function openLinkedQuestion() {
      const target = document.getElementById(window.location.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    }

    openLinkedQuestion();
    window.addEventListener('hashchange', openLinkedQuestion);
  </script>
</Layout>

<style>
  .faq-topics {
    max-width: 54rem;
    display: grid;
    gap: 36px;
  }

  .faq-topics h2 {
    font-size: 23px;
    margin-bottom: 12px;
  }

  .faq-questions {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .faq-questions details + details { border-top: 1px solid var(--border); }
  .faq-questions details:target { box-shadow: inset 3px 0 var(--accent); }
  .faq-questions details[open] { padding-bottom: 16px; }

  .faq-questions summary {
    min-height: 48px;
    margin: 0;
    padding: 13px 18px;
    color: var(--text);
    font-weight: 550;
  }

  .faq-questions summary::marker { color: var(--gold-text); }
  .faq-questions summary:hover { color: var(--accent); }

  .faq-questions p {
    max-width: 72ch;
    margin: 0;
    padding: 0 20px 0 36px;
    color: var(--muted);
  }

  .faq-reference {
    display: inline-block;
    margin: 8px 20px 0 36px;
    font-weight: 550;
  }
</style>
