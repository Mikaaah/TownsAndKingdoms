---
import '../styles/handbook-guide.css';
import CraftingDiagram from '../components/CraftingDiagram.astro';
import LevelScalingDiagram from '../components/LevelScalingDiagram.astro';
import QuestIcon from '../components/QuestIcon.astro';
import WoodcraftDiagram from '../components/WoodcraftDiagram.astro';
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/data';

const topics = [
  { id: 'questbook', title: 'Quest book' },
  { id: 'first-steps', title: 'Wood & shelter' },
  { id: 'factory', title: 'Andesite & clay' },
  { id: 'appraisal', title: 'Identify gear' },
  { id: 'skills', title: 'Levels & skills' },
  { id: 'combat', title: 'Epic Fight', url: href('guides/epic-fight/') },
];
const andesite = { name: 'Andesite', image: 'media/tutorial/andesite.png' };
const clayBall = { name: 'Clay Ball', image: 'media/ponder/textures/minecraft/item/clay_ball.png' };
const andesiteAlloy = { name: 'Andesite Alloy', image: 'media/ponder/textures/create/item/andesite_alloy.png' };
const emerald = { name: 'Emerald', image: 'media/ponder/textures/minecraft/item/emerald.png' };
const ironIngot = { name: 'Iron Ingot', image: 'media/ponder/textures/minecraft/item/iron_ingot.png' };
const book = { name: 'Book', image: 'media/ponder/textures/minecraft/item/book.png' };
const identifier = { name: 'Identifier', image: 'media/tutorial/manual-identifier.png' };
---

<Layout title="Getting started" description="Open the quest book, gather wood, andesite and clay, identify your first piece of gear and learn how character levels work.">
  <p class="eyebrow">Handbook / Basics</p>
  <h1>Getting started</h1>
  <p class="intro">Follow your first quests, gather what you need for Create, and turn dungeon finds into gear you can use.</p>

  <nav class="guide-jumps" aria-label="Getting started sections">
    {topics.map(({ id, title, url }) => <a href={url ?? '#' + id}>{title}</a>)}
  </nav>

  <section class="guide-section" id="questbook" aria-labelledby="questbook-title">
    <header class="guide-heading">
      <QuestIcon name="bookopen" size={28} />
      <h2 id="questbook-title">Open the quest book</h2>
    </header>
    <ol class="guide-steps">
      <li>Open your inventory with <kbd>E</kbd> by default. Click the <strong>Quest Book</strong> icon in the upper-left corner.</li>
      <li>Open <strong>Town Square → The Story</strong> and complete <strong>A New Beginning</strong>. Then look under <strong>Forging Ahead</strong> for <strong>Chapter I | Getting Started</strong>.</li>
      <li>Open completed quests to claim their rewards. To set a shortcut, find <strong>Open Quests</strong> under <strong>FTB Quests</strong> in <strong>Options → Controls → Key Binds</strong>.</li>
    </ol>
    <figure class="guide-figure">
      <img src={href('media/tutorial/quest-book-orientation.webp')} width="840" height="226" decoding="async" alt="The purple Quest Book icon and the Story, Chapters and Market sections." />
    </figure>
    <p><a href={href('guides/tutorial/')}>Open the full in-game tutorial</a> for chapter milestones, claims and travel.</p>
  </section>

  <section class="guide-section" id="first-steps" aria-labelledby="first-steps-title">
    <header class="guide-heading">
      <QuestIcon name="lantern" size={28} />
      <h2 id="first-steps-title">Chop wood and set up camp</h2>
    </header>
    <p>Hold left click on a tree trunk to break your first logs by hand. Turn some into planks, sticks and a crafting table. Make a wooden pickaxe, mine cobblestone for a stone axe, and gather food before heading farther out.</p>
    <WoodcraftDiagram />
    <p>Keep a few whole logs. Right-click one with an axe to strip it, then apply Andesite Alloy to make a Create Andesite Casing.</p>
  </section>

  <section class="guide-section" id="factory" aria-labelledby="factory-title">
    <header class="guide-heading">
      <QuestIcon name="pickaxe" size={28} />
      <h2 id="factory-title">Gather andesite and clay</h2>
    </header>
    <ol class="guide-steps">
      <li><strong>Mine andesite.</strong> Look for speckled gray patches in exposed stone, especially on hillsides and in shallow caves. Bring a pickaxe.</li>
      <li><strong>Dig for clay balls.</strong> Look for smooth blue-gray clay on riverbeds and in shallow water. Break it with a shovel.</li>
      <li>
        <strong>Craft Andesite Alloy.</strong> Use the 2 × 2 inventory grid. Stock up for your first Makeshift Mechanisms and Andesite Machine.
        <CraftingDiagram station="Inventory crafting" rows={[[andesite, clayBall], [clayBall, andesite]]} result={andesiteAlloy} />
      </li>
    </ol>
    <p class="guide-tip">Hover over an item in JEI and press <kbd>R</kbd> for its recipes or <kbd>U</kbd> for its uses. Follow <a href={href('chapters/')}>Chapters I and II</a> or browse the <a id="workshop-builds" href={href('tutorials/')}>workshop build guides</a>.</p>
  </section>

  <section class="guide-section" id="appraisal" aria-labelledby="appraisal-title">
    <header class="guide-heading">
      <QuestIcon name="satchel" size={28} />
      <h2 id="appraisal-title">Build your first Identifier</h2>
    </header>
    <CraftingDiagram station="Crafting table" rows={[[emerald, ironIngot, emerald], [ironIngot, book, ironIngot], [ironIngot, ironIngot, ironIngot]]} result={identifier} />
    <ol class="guide-steps">
      <li>Place the Identifier, right-click it and put an <strong>unidentified equipment token</strong> in the tray.</li>
      <li>Check the <strong>vanilla XP</strong> cost, confirm and collect the revealed gear.</li>
      <li>Compare the stats and affixes before equipping or salvaging it.</li>
    </ol>
    <p>See <a href={href('loot/')}>Loot &amp; Appraisal</a> for loot sources, salvage and the Mechanical Identifier.</p>
  </section>

  <section class="guide-section" id="skills" aria-labelledby="skills-title">
    <header class="guide-heading">
      <QuestIcon name="skill_point" size={28} />
      <h2 id="skills-title">Read levels and spend skill points</h2>
    </header>
    <LevelScalingDiagram />
    <ul>
      <li><strong>Character XP</strong> comes from activities such as fighting, mining natural blocks, farming, fishing and exploring. Level up to earn skill points. You start with a level cap of 10.</li>
      <li><strong>Vanilla XP</strong> is the green experience bar. You spend it at the Identifier and on enchanting.</li>
      <li><strong>Open Character</strong> with <kbd>I</kbd> by default or click your portrait in the survival inventory. Check your progress, choose an Origin and spend points in the skill tree.</li>
      <li><strong>Enemy level badges</strong> appear above scaled mobs. Enemies keep the level they spawn with.</li>
    </ul>
    <p>See <a href={href('mechanics/#leveling')}>Levels &amp; Origins</a> for XP and level caps, or try a route in the <a href={href('skills/')}>skilltree planner</a>.</p>
  </section>

  <section class="guide-section" id="combat" aria-labelledby="combat-title">
    <header class="guide-heading">
      <QuestIcon name="steel_sword" size={28} />
      <h2 id="combat-title">Practice with your first weapon</h2>
    </header>
    <p>Check your weapon’s grip and moveset in the <a href={href('weapons/')}>weapon registry</a>. Try regular, sprinting and aerial attacks on safe terrain so you know their reach before taking on a dungeon.</p>
    <p>Learn Epic Fight attacks, weapon skills, parrying and automatic combat switching in the <a href={href('guides/epic-fight/')}>combat tutorial</a>.</p>
  </section>
</Layout>

<script>
  const movedGuides: Record<string, string> = {
    '#walking-machines': 'guides/walking-machines/',
    '#workshop-builds': 'tutorials/#workshop-builds',
  };

  function followMovedGuide() {
    const destination = movedGuides[location.hash];
    if (destination) location.replace(import.meta.env.BASE_URL + destination);
  }

  window.addEventListener('hashchange', followMovedGuide);
  followMovedGuide();
</script>
