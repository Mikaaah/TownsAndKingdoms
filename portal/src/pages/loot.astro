---
import Layout from '../layouts/Layout.astro';
import MechanicSection from '../components/MechanicSection.astro';
import { data, fmt, href } from '../lib/data';
import '../styles/mechanics.css';

const { loot } = data('mechanics', {});
const sectionByTitle = (sections: any[], title: string) => sections.find(section => section.title === title);
const costRows = sectionByTitle(loot.sections, 'Identification prices').rows;
const rarityRows = sectionByTitle(loot.sections, 'Rarity rolls').rows;
const fluidRows = sectionByTitle(loot.sections, 'Mechanical Identifier').rows;
const sampleTier = costRows.find((row: any) => row.Tier.startsWith('4 ·'));
const sampleRarity = 'Rare';
const steps = [
  {title:'Find sealed gear', description:'Eligible enemies and chests can reward unidentified equipment. A token shows its source, category and loot tier.', image:'media/character/loot-crate.png'},
  {title:'Identify with vanilla XP', description:'Take the token to an Identifier to preview its pool and reveal it. The Mechanical Identifier uses fluid XP.', image:'media/ponder/textures/minecraft/item/experience_bottle.png'},
  {title:'Keep, trade or salvage', description:'Compare the revealed affixes with your build. Salvaging adds fragments you can spend at an Identifier.', image:'media/weapons/minecraft/diamond_sword.png'},
];
---
<Layout title="Loot & Appraisal" description="Learn how to identify and salvage equipment, compare rarity odds, and estimate appraisal costs.">
  <p class="eyebrow">Handbook / Equipment</p>
  <h1 id="loot">Loot &amp; Appraisal</h1>
  <p class="intro">{loot.summary}</p>

  <section class="loot-guide" aria-label="Loot and appraisal guide">
    <ol class="appraisal-steps">
      {steps.map(step => <li><img src={href(step.image)} alt="" width="44" height="44" loading="lazy" /><div><h2>{step.title}</h2><p>{step.description}</p></div></li>)}
    </ol>
    <div class="mechanics-panel appraisal-panel">
      <div class="loot-calculator" data-loot-calculator data-loot-costs={JSON.stringify(costRows)}>
        <h2>Identification cost</h2>
        <p>Estimate the price for affix-capable gear and native jewellery, before salvage credit.</p>
        <div class="loot-options">
          <div><label for="loot-tier">Loot tier</label><select id="loot-tier" disabled>
            {costRows.map((row: any, index: number) => <option value={index} selected={row.Tier === sampleTier.Tier}>{row.Tier}</option>)}
          </select></div>
          <div><label for="loot-rarity">Rarity</label><select id="loot-rarity" disabled>
            {loot.rarities.map((rarity: any) => <option value={rarity.name} selected={rarity.name === sampleRarity}>{rarity.name}</option>)}
          </select></div>
          <div class="loot-route"><label for="loot-route">Identification route</label><select id="loot-route" disabled>
            <option value="manual">Identifier · Vanilla XP</option>
            {fluidRows.map((row: any) => <option value={row['Fluid ID']} data-ratio={row['mB per vanilla XP point']}>Mechanical Identifier · {row['XP fluid'].replace(/^Xp\b/, 'XP')}</option>)}
          </select></div>
        </div>
        <output class="loot-price" for="loot-tier loot-rarity loot-route" data-loot-result><strong data-loot-price>{sampleTier[sampleRarity]}</strong> <span data-loot-unit>vanilla XP points</span></output>
      </div>
      <div class="rarity-chart">
        <h2>Full-range rarity odds</h2>
        <p>Ordinary odds are renormalized when your level ceiling limits rarity.</p>
        <table aria-label="Full-range rarity odds by loot source">
          <thead><tr><th scope="col">Rarity</th><th scope="col">Ordinary</th><th scope="col">Boss</th></tr></thead>
          <tbody>{rarityRows.map((row: any, index: number) => <tr style={`--rarity-color:${loot.rarities[index].color}`}>
            <th scope="row"><span class="rarity-dot"></span>{row.Rarity}</th>
            <td><span class="rarity-bar" style={`--odds:${row['Ordinary roll']}`}>{row['Ordinary roll']}</span></td>
            <td><span class="rarity-bar" style={`--odds:${row['Boss roll']}`}>{row['Boss roll']}</span></td>
          </tr>)}</tbody>
        </table>
      </div>
    </div>
    <section id="automate-identification" class="appraisal-workshop" aria-labelledby="appraisal-workshop-title">
      <h2 id="appraisal-workshop-title">Automate appraisal</h2>
      <p>Feed sealed items into the top or an ordinary side of the <strong>Mechanical Identifier</strong>. Pump a supported XP fluid into its right-hand port and collect the identified equipment from underneath.</p>
      <figure>
        <img src={href('media/loot/mechanical-identifier.webp')} width="850" height="338" loading="lazy" decoding="async" alt="The Mechanical Identifier takes a sealed item from above and pumped Liquid XP through its side port. Identified equipment leaves underneath." />
      </figure>
    </section>
    <div class="mechanics-reference">
      <div class="reference-heading"><h2>Loot reference</h2><span>{fmt(loot.equipmentEntries)} equipment pool entries</span></div>
      <div class="mechanic-list">{loot.sections.map((section: any) => <MechanicSection section={section} collapsible />)}</div>
    </div>
  </section>
</Layout>

<script src="../scripts/loot.js"></script>

<style>
  .loot-guide { margin-top: 32px; }
  .appraisal-steps img {
    flex-shrink: 0;
    image-rendering: pixelated;
    object-fit: contain;
  }
  .loot-options label {
    display: block;
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .loot-options select {
    min-height: 44px;
    min-width: 0;
    width: 100%;
    padding: 7px 10px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--control-border);
    border-radius: 6px;
  }
  .appraisal-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }
  .appraisal-steps li { display: flex; align-items: flex-start; gap: 12px; }
  .appraisal-steps h2 { margin: 0; font-size: 17px; }
  .appraisal-steps p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
  .appraisal-workshop { margin: 32px 0; }
  .appraisal-workshop p { max-width: 74ch; color: var(--muted); }
  .appraisal-workshop figure { margin: 14px 0 0; }
  .appraisal-workshop img { display: block; max-width: 100%; height: auto; }
  .loot-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 16px 0;
  }
  .loot-route { grid-column: 1 / -1; }
  .loot-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 12px;
    border-left: 2px solid var(--gold-border);
    color: var(--gold-text);
    background: var(--gold-surface);
  }
  .loot-price strong { font-size: 25px; font-variant-numeric: tabular-nums; }
  .rarity-chart table { margin-top: 12px; }
  .rarity-chart th,
  .rarity-chart td { padding: 5px 3px; background: transparent; }
  .rarity-chart [scope="row"] { text-transform: none; letter-spacing: 0; font-size: 14px; }
  .rarity-chart td { width: 31%; }
  .rarity-dot {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    display: inline-block;
    border-radius: 50%;
    background: var(--rarity-color);
    outline: 1px solid var(--control-border);
  }
  .rarity-bar {
    display: block;
    position: relative;
    min-width: 48px;
    z-index: 0;
    padding: 0 2px;
    font-variant-numeric: tabular-nums;
  }
  .rarity-bar::before {
    content: '';
    position: absolute;
    inset: auto auto 0 0;
    border-radius: 2px;
    height: 2px;
    width: var(--odds);
    min-width: 1px;
    background: var(--rarity-color);
  }
  @media (max-width: 960px) {
    .appraisal-steps { grid-template-columns: 1fr; }
  }
</style>
