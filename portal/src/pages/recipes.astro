---
import Layout from '../layouts/Layout.astro';
import RegistryDialog from '../components/RegistryDialog.astro';
import { href, data, pretty, words } from '../lib/data';
const families=data('recipe-families');
const rules=data('production-rules');
const percent=(value:number)=>new Intl.NumberFormat('en',{style:'percent',maximumFractionDigits:2}).format(value);
---
<Layout title="Recipe registry" description="Custom crafting, processing and assembly recipes with their real ingredients and progression requirements." wide>
 <p class="eyebrow">Reference / Production</p><h1>Recipe registry</h1><p class="intro">Follow a material from its first component to its next purpose. Inspect crafting arrangements, assembly sequences and the mechanisms that connect each stage of production.</p>
 <div class="button-row"><a class="button" href={href('ponder/')}>Open the Ponder workshop →</a><a class="button" href={href('chapters/')}>Understand the chapters</a></div>
 <div data-registry="recipes"><div class="toolbar"><input type="search" data-filter="query" placeholder="Search an output, ingredient or recipe ID…" aria-label="Search recipes"/><select data-filter="type" aria-label="Filter by process"><option value="">All processes</option></select><select data-filter="modName" aria-label="Filter by mod"><option value="">All mods</option></select><select data-filter="productionTier" aria-label="Filter by production tier"><option value="">All tiers</option></select></div><div class="results-meta"><span data-count>Finding recipes…</span><span>Amounts are per recipe</span></div><div class="table-wrap"><table><thead><tr><th>Result</th><th>Process</th><th>Progression</th><th>Yield</th><th><span class="subtle">Details</span></th></tr></thead><tbody data-results></tbody></table></div><div class="pagination"><button data-prev disabled>← Previous</button><span data-page-label>1 / 1</span><button data-next>Next →</button></div></div>
 {families.length>0&&<section class="section"><p class="eyebrow">Connected production</p><h2>Spell scroll binding</h2><p class="muted">The school focus and ink determine how a spell scroll is prepared and bound.</p>{families.map((f:any)=><article class="card section" id={'family-'+f.id}><h3>{f.name}</h3><ol class="sequence-list">{(f.steps||[]).map((s:any)=><li><span><strong>{s.title}</strong><small>{s.text}</small></span></li>)}</ol><details><summary class="muted">Schools, inks & binding rules</summary><div class="detail-grid"><div><h4>Schools</h4><ul>{(f.schools||[]).map((s:any)=><li>{s.name||pretty(s)}</li>)}</ul></div><div><h4>Inks</h4><ul>{(f.inks||[]).map((s:any)=><li>{s.name||pretty(s)}</li>)}</ul></div></div><ul class="muted">{(f.rules||[]).map((rule:string)=><li>{rule}</li>)}</ul></details></article>)}</section>}
 {rules.length>0&&<section class="section" id="production-rules"><p class="eyebrow">Industrial processes</p><h2>Excavator deposits &amp; liquid fuel</h2><p class="muted">Inspect deposit rolls and fuel behavior alongside the item-producing recipes.</p><div class="process-rules">{rules.map((rule:any)=>{const r=rule.recipe;return <details id={'rule-'+rule.id.replace(':','/')} class="process-rule"><summary><span>{rule.name}</span><small>{words(rule.type)}</small></summary><p><code>{rule.id}</code></p>{rule.type==='immersiveengineering:mineral_mix'?<><dl class="detail-grid"><div><dt>Deposit weight</dt><dd>{r.weight}</dd></div><div><dt>Failed extraction roll</dt><dd>{percent(r.fail_chance||0)}</dd></div></dl><div class="table-wrap"><table><thead><tr><th>Ore roll</th><th>Chance</th></tr></thead><tbody>{(r.ores||[]).map((ore:any)=><tr><td>{words(ore.output?.id||ore.output?.item)}</td><td>{percent(ore.chance)}</td></tr>)}</tbody></table></div><p class="detail-note">Spoils: {(r.spoils||[]).map((spoil:any)=>`${words(spoil.output?.id||spoil.output?.item)} (${percent(spoil.chance)})`).join(' · ')}</p><p class="detail-note">Biome tag groups: {(r.biome_predicates||[]).map((group:any)=>group.join(', ')).join(' / ')}</p></>:<><p>{(r.ingredients||[]).map((input:any)=>`${input.amount||1000} mB ${words(input.tag||input.fluid||input.id)}`).join(' + ')}</p><dl class="detail-grid"><div><dt>Burn time</dt><dd>{r.burn_time.toLocaleString()} ticks · {(r.burn_time/20).toLocaleString()} seconds</dd></div><div><dt>Superheating</dt><dd>{r.superheated?'Yes':'No'}</dd></div></dl></>}</details>})}</div></section>}
 <RegistryDialog />
 <script>
  import '../scripts/registry';
  function revealRule(){let id='';try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}const target=document.getElementById(id);if(target instanceof HTMLDetailsElement&&target.classList.contains('process-rule'))target.open=true;}
  revealRule();window.addEventListener('hashchange',revealRule);
 </script>
</Layout>
<style>.process-rules{display:grid;gap:8px}.process-rule{border:1px solid var(--border);border-radius:7px;padding:14px 18px;background:var(--surface);scroll-margin-top:100px}.process-rule summary{display:flex;gap:18px;justify-content:space-between;align-items:center;font-weight:550}.process-rule summary>*{min-width:0;overflow-wrap:anywhere}.process-rule summary small{color:var(--muted);font-size:13px;font-weight:400}.process-rule p{font-size:16px;color:var(--muted)}.process-rule table{font-size:14px;max-width:640px}.process-rule code{font-size:13px}@media(max-width:520px){.process-rule summary{align-items:flex-start;flex-direction:column;gap:2px}}</style>
