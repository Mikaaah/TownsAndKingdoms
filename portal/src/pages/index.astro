---
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import Layout from '../layouts/Layout.astro';
import QuestIcon from '../components/QuestIcon.astro';
import { href } from '../lib/data';

const handbookLinks = [
  { title: 'Weapons', path: 'weapons/', icon: 'hammer' },
  { title: 'Recipes', path: 'recipes/', icon: 'paper' },
  { title: 'Progression chapters', path: 'chapters/', icon: 'scroll' },
  { title: 'Skilltree planner', path: 'skills/', icon: 'skill_point' },
  { title: 'Character & Origins', path: 'mechanics/', icon: 'mirror' },
  { title: 'Loot & Appraisal', path: 'loot/', icon: 'satchel' },
  { title: 'Build guides', path: 'tutorials/', icon: 'rotation_mechanism' },
  { title: 'Boss encounters', path: 'bosses/', icon: 'horn' },
  { title: 'Mods & integrations', path: 'mods/', icon: 'journal' },
];

const startingGuides = [
  { title: 'Your first evening', summary: 'Make a home and put your first machines to work.', path: 'guides/#first-steps', icon: 'lantern' },
  { title: 'Find your fighting style', summary: 'Compare weapon grips and learn how innate attacks work.', path: 'guides/#combat', icon: 'hammer' },
  { title: 'Appraise your dungeon finds', summary: 'Identify and salvage gear to find equipment for your build.', path: 'loot/', icon: 'satchel' },
];
---
<Layout description="The Towns & Kingdoms 3 player handbook for recipes, progression, combat and character builds.">
  <section class="home-cover" aria-labelledby="home-title">
    <div class="home-cover-copy">
      <p class="eyebrow">Player handbook</p>
      <h1 id="home-title">
        <img src={href('media/logo.webp')} alt="Towns & Kingdoms 3 — Beyond the Forge" width="688" height="276" fetchpriority="high" />
      </h1>
      <p class="home-lead">Plan your character, find crafting recipes and follow the modpack’s progression from your first workshop onward.</p>
      <div class="button-row">
        <a class="button button-primary" href={href('guides/')}>Getting started</a>
        <a class="button" href={href('features/')}>Explore the pack</a>
      </div>
    </div>
    <ScreenshotGallery />
  </section>

  <nav class="home-directory" aria-labelledby="home-directory-title">
    <h2 id="home-directory-title">Browse the handbook</h2>
    <div class="button-row">
      {handbookLinks.map(({ title, path, icon }) => (
        <a class="button" href={href(path)}><QuestIcon name={icon} size={20} />{title}</a>
      ))}
    </div>
  </nav>

  <section class="home-guides" aria-labelledby="home-guides-title">
    <div>
      <h2 id="home-guides-title">A place to begin</h2>
      <a href={href('tutorials/')}>Browse build guides</a>
    </div>
    <div class="home-guide-links">
      {startingGuides.map(({ title, summary, path, icon }) => (
        <a href={href(path)}>
          <QuestIcon name={icon} size={24} />
          <span><strong>{title}</strong><small>{summary}</small></span>
        </a>
      ))}
    </div>
  </section>

  <aside class="home-archive" aria-label="Towns and Kingdoms 2 handbook">
    <QuestIcon name="candle" size={22} />
    <p>Coming from Towns &amp; Kingdoms 2? See <a href={href('changes/')}>what changed</a> or return to the <a href={href('tk2/')}>TK2 handbook</a>.</p>
  </aside>
</Layout>

<style>
  .home-cover {
    display: grid;
    grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--border);
  }

  .home-cover .eyebrow { margin-bottom: 10px; }
  .home-cover h1 { margin: 0 0 18px; }
  .home-cover h1 img { display: block; width: min(100%, 460px); }
  .home-lead { max-width: 36ch; margin-bottom: 22px; color: var(--muted); }

  .home-directory { margin: 32px 0 42px; }
  .home-directory h2, .home-guides h2 { margin-bottom: 14px; font-size: 24px; }
  .home-directory .button-row { gap: 9px; }
  .home-directory .button { justify-content: start; padding: 8px 12px; }
  .home-directory .button:hover { border-color: var(--accent); }

  .home-guides {
    display: grid;
    grid-template-columns: minmax(170px, .7fr) minmax(0, 1.3fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .home-guide-links { display: grid; gap: 2px; }
  .home-guide-links a {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    color: var(--text);
    padding: 8px 0;
  }
  .home-guide-links a:hover { text-decoration: none; }
  .home-guide-links a:hover strong { color: var(--accent); }
  .home-guide-links strong { display: block; font-size: 15px; font-weight: 550; }
  .home-guide-links small { display: block; color: var(--muted); }

  .home-archive {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }
  .home-archive p { margin: 0; }

  @media (800px < width <= 1050px), (width <= 650px) {
    .home-cover { grid-template-columns: 1fr; }
  }

  @media (width <= 650px) {
    .home-cover { padding-bottom: 24px; }
    .home-cover h1 img { width: min(100%, 365px); }
    .home-guides { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
