---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import QuestIcon from '../components/QuestIcon.astro';
import { data, href, fmt } from '../lib/data';

const weapons = data('weapons');
const recipes = data('recipes');
const chapters = data('chapters');
const styles = data('styles');
const skills = data('skills', { nodes: [], edges: [], branches: [] });
const ponder = data('ponder', { scenes: [] });
const featuredWeapons = [
  'simplyswords:iron_katana',
  'simplyswords:iron_greathammer',
  'simplyswords:runic_longsword',
].map(id => weapons.find((weapon: any) => weapon.id === id)).filter(Boolean);
const featuredRecipe = recipes.find((recipe: any) => recipe.id === 'tnk:chapter_01/crafting/andesite_alloy_from_andesite_and_clay');
const recipeArt: Record<string, string> = {
  'minecraft:andesite': 'media/ponder/textures/minecraft/block/andesite.png',
  'minecraft:clay_ball': 'media/ponder/textures/minecraft/item/clay_ball.png',
};
const recipePattern = featuredRecipe?.recipe?.pattern ?? [];
const recipeSlots = recipePattern.flatMap((row: string) => row.split('').map(symbol => {
  const ingredient = featuredRecipe.recipe.key[symbol];
  const entry = featuredRecipe.ingredients.find((item: any) => item.id === ingredient.item);
  return { id: ingredient.item, name: entry?.name ?? ingredient.item, art: recipeArt[ingredient.item] };
}));
const featuredNode = skills.nodes.find((node: any) => node.id === 'blacksmith_class');
const nodeIds = new Set([featuredNode?.id, ...skills.edges.flatMap(([from, to]: string[]) => from === featuredNode?.id ? [to] : to === featuredNode?.id ? [from] : [])]);
const branchNodes = skills.nodes.filter((node: any) => nodeIds.has(node.id));
const branchEdges = skills.edges.filter(([from, to]: string[]) => nodeIds.has(from) && nodeIds.has(to)).map(([from, to]: string[]) => ({ from: branchNodes.find((node: any) => node.id === from), to: branchNodes.find((node: any) => node.id === to) }));
const graphBounds = {
  x: Math.min(...branchNodes.map((node: any) => node.x)) - 30,
  y: Math.min(...branchNodes.map((node: any) => node.y)) - 26,
  width: Math.max(...branchNodes.map((node: any) => node.x)) - Math.min(...branchNodes.map((node: any) => node.x)) + 60,
  height: Math.max(...branchNodes.map((node: any) => node.y)) - Math.min(...branchNodes.map((node: any) => node.y)) + 52,
};
const directory = [
  { title: 'Progression chapters', description: 'Mechanisms, milestones and production requirements.', link: 'chapters/', detail: `${chapters.length} chapters`, icon: 'scroll' },
  { title: 'Ponder workshop', description: 'Inspect machinery and step through production scenes.', link: 'ponder/', detail: `${fmt(ponder.scenes.length)} scenes`, icon: 'rotation_mechanism' },
  { title: 'Mods & integrations', description: 'Browse gameplay systems, addons and supporting libraries.', link: 'mods/', detail: 'Mod index', icon: 'journal' },
  { title: 'Boss encounters', description: 'Look up encounter rewards and equipment pools.', link: 'bosses/', detail: 'Combat reference', icon: 'horn' },
];
---
<Layout description="The Towns & Kingdoms 3 player handbook: compare weapons, find recipes, follow production chapters and plan your character.">
  <section class="home-cover" aria-labelledby="home-title">
    <div class="home-cover-copy">
      <p class="home-kicker">Beyond the Forge <span aria-hidden="true">/</span> Player handbook</p>
      <h1 id="home-title"><span class="home-title-towns">Towns &amp;</span> <br /><span class="home-title-kingdoms">Kingdoms 3</span></h1>
      <p class="home-lead">Find your weapon style. Follow a recipe from ingredients to output. Build a character around the way you play.</p>
      <div class="button-row home-actions">
        <a class="button button-primary" href={href('weapons/')}>Find a weapon <Icon name="external" size={16} /></a>
        <a class="button" href={href('guides/')}>Read the guide</a>
      </div>
      <p class="home-cover-note">Search by name or item ID, or choose a reference below.</p>
    </div>
    <div class="home-weapon-preview">
      <div class="home-preview-heading">
        <h2><a href={href('weapons/')}><span class="home-heading-label"><QuestIcon name="hammer" />Weapon registry</span><Icon name="external" size={16} /></a></h2>
        <p>{fmt(weapons.length)} weapons <span aria-hidden="true">·</span> {styles.length} styles</p>
      </div>
      <div class="home-weapon-lineup">
        {featuredWeapons.map((weapon: any) => <a class="home-weapon" href={href('weapons/#item=' + encodeURIComponent(weapon.id))}>
          <div class="home-weapon-art"><img src={href(weapon.icon)} alt="" width="104" height="136" /></div>
          <div class="home-weapon-info"><h3>{weapon.name}</h3><p class="home-weapon-style">{weapon.styleName}</p><dl><div><dt>Grip</dt><dd>{weapon.grip}</dd></div><div><dt>Impact</dt><dd>{weapon.attributes.common.impact}</dd></div></dl></div>
        </a>)}
      </div>
    </div>
  </section>

  <div class="home-tools">
    <section class="home-production" aria-labelledby="home-production-title">
      <div class="home-tool-heading"><h2 id="home-production-title" class="home-heading-label"><QuestIcon name="paper" size={24} />Recipes &amp; production</h2><span>{fmt(recipes.length)} recipes</span></div>
      <p>Check an arrangement, trace an ingredient and see where it fits in your workshop.</p>
      {featuredRecipe && <a class="home-recipe-preview" href={href('recipes/#recipe=' + encodeURIComponent(featuredRecipe.id))} aria-label={`Read the ${featuredRecipe.name} recipe`}>
        <div class="home-recipe-top"><span>Chapter {featuredRecipe.chapter} <span aria-hidden="true">/</span> Crafting</span><Icon name="external" size={16} /></div>
        <div class="home-crafting">
          <div class="home-crafting-grid" style={`--recipe-columns:${recipePattern[0]?.length || 2}`} role="img" aria-label={`Crafting arrangement: ${recipeSlots.map((slot: any) => slot.name).join(', ')}`}>
            {recipeSlots.map((slot: any) => <div class="home-crafting-slot"><img src={href(slot.art)} alt="" width="42" height="42" /></div>)}
          </div>
          <span class="home-crafting-arrow" aria-hidden="true">→</span>
          <div class="home-crafting-output"><img src={href('media/ponder/textures/create/item/andesite_alloy.png')} alt="" width="68" height="68" /><strong>{featuredRecipe.name}</strong><span>{featuredRecipe.count} item</span></div>
        </div>
        <div class="home-recipe-ingredients">{featuredRecipe.ingredients.map((ingredient: any, index: number) => <><span>{ingredient.count} × {ingredient.name}</span>{index < featuredRecipe.ingredients.length - 1 && <span aria-hidden="true">+</span>}</>)}</div>
      </a>}
      <a class="home-text-link" href={href('recipes/')}>Browse recipes <span aria-hidden="true">→</span></a>
    </section>
    <section class="home-character" aria-labelledby="home-character-title">
      <div class="home-tool-heading"><h2 id="home-character-title" class="home-heading-label"><QuestIcon name="skill_point" size={24} />Your character, planned</h2><span>{fmt(skills.nodes.length)} skills</span></div>
      <p>Connect skills across {skills.branches.length} professions, compare bonuses and share your build.</p>
      {featuredNode && <a class="home-skill-preview" href={href('skills/#node=' + encodeURIComponent(featuredNode.id))} aria-label={`Open ${featuredNode.title} in the skilltree planner`}>
        <div class="home-skill-heading"><span>Blacksmith</span><span>{featuredNode.cost} point</span></div>
        <svg class="home-skill-graph" viewBox={`${graphBounds.x} ${graphBounds.y} ${graphBounds.width} ${graphBounds.height}`} role="img" aria-label="Tempered Craft and its five connected skills in the Blacksmith branch">
          {branchEdges.map((edge: any) => <line x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} />)}
          {branchNodes.map((node: any) => <g class:list={{ 'home-root-node': node.id === featuredNode.id }}><title>{node.title}</title><circle cx={node.x} cy={node.y} r={node.id === featuredNode.id ? 15 : 9} />{node.id === featuredNode.id && <circle class="home-node-core" cx={node.x} cy={node.y} r="4" />}</g>)}
        </svg>
        <div class="home-skill-detail"><strong>{featuredNode.title}</strong><p>{featuredNode.description.split('\n').map((line: string) => <span>{line}</span>)}</p></div>
      </a>}
      <a class="home-text-link" href={href('skills/')}>Open skill planner <span aria-hidden="true">→</span></a>
    </section>
  </div>

  <section class="home-directory" aria-labelledby="home-directory-title">
    <h2 id="home-directory-title">More from the handbook</h2>
    <div class="home-directory-list">{directory.map(item => <a href={href(item.link)} class="home-directory-row"><QuestIcon name={item.icon} size={28} /><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="home-directory-detail">{item.detail}</span><span class="home-directory-arrow" aria-hidden="true">→</span></a>)}</div>
  </section>

  <section class="home-guides" aria-labelledby="home-guides-title">
    <div class="home-guide-intro"><h2 id="home-guides-title">A place to begin</h2><p>A few references to keep close during your first days.</p><a class="home-text-link" href={href('guides/')}>Read all guides <span aria-hidden="true">→</span></a></div>
    <div class="home-guide-links">
      <a href={href('guides/#first-steps')}><QuestIcon name="lantern" size={24} /><div><h3>Your first evening</h3><p>Make a home and put your first machines to work.</p></div><span aria-hidden="true">→</span></a>
      <a href={href('guides/#combat')}><QuestIcon name="hammer" size={24} /><div><h3>Find your fighting style</h3><p>Understand weapon identity, grip and innate attacks.</p></div><span aria-hidden="true">→</span></a>
      <a href={href('mechanics/#loot')}><QuestIcon name="satchel" size={24} /><div><h3>Bring your discoveries home</h3><p>Identify dungeon gear and find equipment for your build.</p></div><span aria-hidden="true">→</span></a>
    </div>
  </section>

  <aside class="home-archive" aria-label="Towns and Kingdoms 2 handbook">
    <QuestIcon name="candle" size={24} /><div><strong>Coming from Towns &amp; Kingdoms 2?</strong><p>Read <a href={href('changes/')}>what changed</a> or return to the complete <a href={href('tk2/')}>TK2 handbook</a>.</p></div>
  </aside>
</Layout>

<style>
  .home-cover{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:48px;padding:16px 0 48px;align-items:center;border-bottom:1px solid var(--border)}
  .home-kicker{font-size:13px;color:var(--gold-text);margin-bottom:24px;font-weight:500}
  .home-kicker span{color:var(--subtle);margin:0 7px}
  .home-cover h1{font-size:clamp(38px,4.35vw,65px);font-weight:600;letter-spacing:-.055em;line-height:1.04;margin-bottom:24px}
  .home-title-kingdoms{color:var(--primary)}
  :global(:root:not([data-theme='light'])) .home-title-kingdoms{color:var(--accent)}
  @supports (background-clip: text) {
    :global(:root:not([data-theme='light'])) .home-title-towns,
    :global(:root:not([data-theme='light'])) .home-title-kingdoms {
      background-clip: text;
      color: transparent;
    }
    :global(:root:not([data-theme='light'])) .home-title-towns{background-image:var(--wordmark-towns)}
    :global(:root:not([data-theme='light'])) .home-title-kingdoms{background-image:var(--wordmark-kingdoms)}
  }
  @media (forced-colors: active) {
    :global(:root:not([data-theme='light'])) .home-title-towns,
    :global(:root:not([data-theme='light'])) .home-title-kingdoms{color:CanvasText}
  }
  .home-lead{font-size:17px;line-height:1.7;color:var(--muted);max-width:420px;margin-bottom:28px}
  .home-actions{gap:10px}
  .home-cover-note{font-size:13px;line-height:1.65;color:var(--subtle);max-width:370px;margin:24px 0 0}
  .home-weapon-preview{min-width:0;border:1px solid var(--primary);border-top:2px solid var(--gold);background:var(--surface);padding:20px 20px 24px;border-radius:0 0 var(--radius) var(--radius)}
  .home-heading-label{display:flex;align-items:center;gap:10px;min-width:0}
  .home-preview-heading{margin-bottom:16px}
  .home-preview-heading h2{margin:0;font-size:16px;line-height:1.4;letter-spacing:0}.home-preview-heading a{display:flex;justify-content:space-between;align-items:center;color:var(--text);font-weight:550;font-size:16px;min-height:28px}
  .home-preview-heading p{color:var(--subtle);font-size:13px;margin:3px 0 0}
  .home-preview-heading p span{margin:0 5px}
  .home-weapon-lineup{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .home-weapon{color:var(--text);min-width:0}
  .home-weapon:hover{text-decoration:none}
  .home-weapon-art{height:164px;display:flex;justify-content:center;align-items:center;padding:10px 0 18px}
  .home-weapon-art img{width:104px;height:136px;object-fit:contain;image-rendering:pixelated;transition:transform .16s ease}
  .home-weapon:hover .home-weapon-art img{transform:translateY(-2px)}
  .home-weapon-info h3{font-size:15px;line-height:1.4;letter-spacing:-.015em;margin-bottom:7px;min-height:42px}
  .home-weapon-style{font-size:13px;line-height:1.45;color:var(--gold-text);min-height:38px;margin-bottom:14px}
  .home-weapon dl{margin:0;font-size:13px;line-height:1.5;border-top:1px solid var(--border)}
  .home-weapon dl>div{padding-top:8px}
  .home-weapon dt{color:var(--subtle);font-size:13px;margin-bottom:2px}
  .home-weapon dd{margin:0;color:var(--muted)}
  .home-tools{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:42px 0 48px}
  .home-tools section{min-width:0;display:flex;flex-direction:column}
  .home-tool-heading{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-bottom:12px}
  .home-tool-heading h2{font-size:23px;line-height:1.3;margin:0}
  .home-tool-heading>span{color:var(--gold-text);font-size:13px;white-space:nowrap}
  .home-tools section>p{font-size:15px;line-height:1.7;color:var(--muted);margin-bottom:22px;max-width:44ch}
  .home-recipe-preview,.home-skill-preview{display:block;color:var(--text);background:var(--surface);border:1px solid var(--primary);border-radius:var(--radius);padding:20px;flex:1;transition:border-color .16s ease}
  .home-recipe-preview:hover,.home-skill-preview:hover{border-color:var(--gold-text);text-decoration:none}
  .home-recipe-top,.home-skill-heading{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--muted)}
  .home-recipe-top span span{color:var(--subtle);margin:0 6px}
  .home-crafting{display:flex;align-items:center;justify-content:center;gap:24px;margin:26px 0}
  .home-crafting-grid{display:grid;grid-template-columns:repeat(var(--recipe-columns),54px);gap:4px}
  .home-crafting-slot{width:54px;height:54px;background:var(--surface-raised);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;border-radius:3px}
  .home-crafting-slot img{width:42px;height:42px;object-fit:contain;image-rendering:pixelated}
  .home-crafting-arrow{font-size:28px;color:var(--subtle)}
  .home-crafting-output{display:flex;align-items:center;flex-direction:column;gap:5px;max-width:118px;text-align:center}
  .home-crafting-output img{width:68px;height:68px;object-fit:contain;image-rendering:pixelated;margin-bottom:3px}
  .home-crafting-output strong{font-size:14px;font-weight:550;line-height:1.4}
  .home-crafting-output span{font-size:13px;color:var(--subtle)}
  .home-recipe-ingredients{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px;font-size:13px;color:var(--muted);border-top:1px solid var(--border);padding-top:15px}
  .home-recipe-ingredients>span:nth-child(2n){color:var(--subtle)}
  .home-skill-heading>span:first-child{color:var(--gold-text)}
  .home-skill-graph{display:block;width:100%;height:155px;margin:4px auto 3px}
  .home-skill-graph line{stroke:var(--border);stroke-width:2}
  .home-skill-graph circle{fill:var(--surface-raised);stroke:var(--subtle);stroke-width:1.3}
  .home-skill-graph .home-root-node>circle{fill:var(--accent-dark);stroke:var(--gold);stroke-width:1.8}
  .home-skill-graph .home-root-node>.home-node-core{fill:var(--gold);stroke:none}
  .home-skill-detail{border-top:1px solid var(--border);padding-top:13px}
  .home-skill-detail strong{font-size:14px;font-weight:550}
  .home-skill-detail p{font-size:13px;line-height:1.55;color:var(--muted);margin:5px 0 0}
  .home-skill-detail p span{display:block}
  .home-text-link{display:inline-flex;align-items:center;gap:12px;font-size:14px;font-weight:550;min-height:44px;align-self:flex-start;margin-top:12px}
  .home-text-link span{transition:transform .16s ease}
  .home-text-link:hover span{transform:translateX(3px)}
  .home-directory{margin-bottom:48px}
  .home-directory>h2{font-size:25px;margin-bottom:20px}
  .home-directory-list{border-top:1px solid var(--border)}
  .home-directory-row{display:grid;grid-template-columns:28px minmax(0,1fr) auto 18px;align-items:center;gap:18px;padding:20px 0;border-bottom:1px solid var(--border-soft);color:var(--text)}
  .home-directory-row:hover{text-decoration:none}
  .home-directory-row h3{font-size:17px;margin:0 0 4px}
  .home-directory-row p{font-size:14px;color:var(--muted);margin:0;line-height:1.6}
  .home-directory-detail{font-size:13px;color:var(--subtle)}
  .home-directory-arrow{color:var(--accent);transition:transform .16s ease}
  .home-directory-row:hover .home-directory-arrow{transform:translateX(3px)}
  .home-guides{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:48px;margin-bottom:42px}
  .home-guide-intro h2{font-size:25px;margin-bottom:12px}
  .home-guide-intro>p{color:var(--muted);font-size:15px;line-height:1.7;margin-bottom:8px;max-width:28ch}
  .home-guide-intro .home-text-link{margin-top:0}
  .home-guide-links{border-top:1px solid var(--border)}
  .home-guide-links>a{display:grid;grid-template-columns:24px minmax(0,1fr) 14px;gap:14px;align-items:start;padding:18px 0;border-bottom:1px solid var(--border-soft);color:var(--text)}
  .home-guide-links>a:hover{text-decoration:none}
  .home-guide-links h3{font-size:15px;margin:0 0 4px}
  .home-guide-links p{font-size:13px;color:var(--muted);line-height:1.6;margin:0}
  .home-guide-links>a>span:last-child{color:var(--accent)}
  .home-archive{display:flex;gap:16px;align-items:flex-start;border-left:2px solid var(--gold);padding:20px 24px;background:var(--surface);border-radius:0 var(--radius) var(--radius) 0}
  .home-archive strong{font-size:15px;font-weight:550}
  .home-archive p{font-size:14px;line-height:1.7;color:var(--muted);margin:4px 0 0}
  @media(min-width:1600px){.home-cover{gap:64px}.home-weapon-art{height:180px}}
  @media(max-width:1200px){.home-cover{gap:28px;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}.home-cover h1{font-size:48px}.home-weapon-preview{padding:16px}.home-weapon-lineup{gap:12px}.home-weapon-art{height:136px}.home-weapon-art img{width:86px;height:112px}.home-tools{gap:24px}.home-tool-heading{align-items:start;flex-direction:column;gap:6px}.home-tools section>p{min-height:76px}.home-crafting{gap:16px}.home-guides{gap:32px}}
