---
import Layout from '../layouts/Layout.astro';
import MechanicSection from '../components/MechanicSection.astro';
import QuestIcon from '../components/QuestIcon.astro';
import badgeArt from '../data/character-title-badges.json';
import { data, fmt, href } from '../lib/data';
import '../styles/mechanics.css';

const { leveling, origins, originGuide, titles } = data('mechanics', {});
const sectionByTitle = (sections: any[], title: string) => sections.find(section => section.title === title);
const milestones = sectionByTitle(leveling.sections, 'Levels and skill points').rows;
const sampleLevel = milestones.find((row: any) => row.Level === 25);
const ceilings = sectionByTitle(leveling.sections, 'Campaign ceilings').rows;
const titleBadges: Record<string, {width: number, offset: number}> = badgeArt.entries;
const featuredTitles = ['tnk:apprentice', 'tnk:technician', 'tnk:engineer'].map(id => titles.catalog.find((title: any) => title.id === id)).filter(Boolean);
const nav = [
  {id:'leveling', label:'Leveling', icon:'skill_point'},
  {id:'origins', label:'Origins', icon:'mirror'},
  {id:'titles', label:'Titles', icon:'scroll'},
];
const ascensionRecipe = 'recipes/#recipe=' + encodeURIComponent('tnk:endgame/mechanical_crafting/sigil_of_ascension');
const badgeStyle = (id: string) => {
  const art = titleBadges[id];
  return `background-image:url(${href('media/character/title-badges.png')});background-size:auto ${badgeArt.height * 2}px;background-position:0 -${art.offset * 2}px;width:${art.width * 2}px`;
};
---
<Layout title="Character & Origins" description="Plan your character levels and skill points, compare Origins, and browse titles in Towns & Kingdoms 3.">
  <p class="eyebrow">Handbook / Character systems</p>
  <h1>Character &amp; Origins</h1>
  <p class="intro">Check how many skill points a level earns, find an Origin that fits your playstyle, and browse the titles you can earn.</p>
  <div class="character-navigation">
    <nav class="toc-inline mechanics-nav" aria-label="Character systems">
      {nav.map(({id, label, icon}) => <a href={'#'+id}><QuestIcon name={icon} size={20} />{label}</a>)}
    </nav>
    <a id="loot" class="button" href={href('loot/')}>Go to Loot &amp; Appraisal<QuestIcon name="back" kind="ui" /></a>
  </div>
  <script is:inline define:vars={{ lootUrl: href('loot/') }}>
    function forwardLegacyLootLink() {
      if (window.location.hash === '#loot') window.location.replace(lootUrl);
    }
    forwardLegacyLootLink();
    window.addEventListener('hashchange', forwardLegacyLootLink);
  </script>

  <section id="leveling" class="mechanics-section" aria-labelledby="leveling-title">
    <header class="mechanics-heading">
      <QuestIcon name="skill_point" size={34} />
      <div><h2 id="leveling-title">{leveling.title}</h2><p>{leveling.summary}</p></div>
    </header>
    <div class="mechanics-panel progression-panel">
      <div class="level-calculator" data-level-calculator data-level-base={leveling.levelCost.base} data-level-factor={leveling.levelCost.factor} data-level-exponent={leveling.levelCost.exponent}>
        <div class="level-calculator-heading">
          <label for="character-level">Character level</label>
          <output id="character-level-selected" for="character-level" data-level-selected>{sampleLevel.Level}</output>
        </div>
        <input type="range" min="1" max={leveling.maximumLevel} value={sampleLevel.Level} id="character-level" disabled data-level-control />
        <div class="level-extremes" aria-hidden="true"><span>1</span><span>{leveling.maximumLevel}</span></div>
        <dl class="progression-totals">
          <div><dt>Skill points</dt><dd><output for="character-level" data-level-points>{sampleLevel['Earned skill points']}</output></dd></div>
          <div><dt>Total character XP</dt><dd><output for="character-level" data-level-total>{sampleLevel['Total character XP']}</output></dd></div>
          <div><dt>XP to next level</dt><dd><output for="character-level" data-level-next>{sampleLevel['XP to next level']}</output></dd></div>
        </dl>
        <a class="button button-primary" href={href('skills/')}>Open skill planner</a>
      </div>
      <div class="level-ceilings">
        <h3>Campaign ceilings</h3>
        <p>Campaign unlocks raise your level ceiling and determine your highest ordinary loot rarity.</p>
        <ol class="ceiling-list">
          {ceilings.map((row: any) => <li><span>Level <strong>{row['Character ceiling']}</strong></span><span>{row['Highest ordinary rarity']}</span></li>)}
        </ol>
      </div>
    </div>
    <div class="mechanics-reference" aria-label="Leveling reference">
      <h3>XP sources and enemy scaling</h3>
      <div class="mechanic-list">{leveling.sections.map((section: any) => <MechanicSection section={section} collapsible />)}</div>
    </div>
  </section>

  <section id="origins" class="mechanics-section" aria-labelledby="origins-title">
    <header class="mechanics-heading">
      <QuestIcon name="mirror" size={34} />
      <div><h2 id="origins-title">Origins</h2><p>{originGuide.summary}</p></div>
    </header>
    <div class="origin-controls" data-origin-controls hidden>
      <div><label for="origin-search">Find an Origin or perk</label><input id="origin-search" type="search" placeholder="e.g. mining or mana" autocomplete="off" /></div>
      <div><label for="origin-tier">Origin type</label><select id="origin-tier"><option value="">All Origins</option><option value="Origin">Starting Origins</option><option value="Ascended">Ascended Origins</option></select></div>
      <span class="origin-count" role="status" data-origin-count>{origins.length} Origins</span>
    </div>
    <div class="origin-grid" data-origin-grid>
      {origins.map((origin: any) => <article class="origin-entry" id={'origin-'+origin.id} data-origin-tier={origin.tier}>
        <header class="origin-heading">
          {origin.icon && <img src={href(origin.icon)} alt="" width="32" height="32" loading="lazy" />}
          <h3>{origin.name}</h3>
          {origin.tier === 'Ascended' && <span class="origin-ascended" title="Ascended Origin"><QuestIcon name="potionblue" size={20} /><span class="sr-only">Ascended</span></span>}
        </header>
        <ul class="origin-perks" aria-label={origin.name + ' perks'}>
          {origin.perks.map((perk: any) => <li>{perk.description}</li>)}
        </ul>
        <p class="origin-description">{origin.description}</p>
      </article>)}
    </div>
    <div class="mechanics-reference">
      <div class="reference-heading"><h3>Choosing or changing your Origin</h3><a class="button" href={href(ascensionRecipe)}>Sigil of Ascension recipe</a></div>
      <div class="mechanic-list">{originGuide.sections.map((section: any) => <MechanicSection section={section} collapsible />)}</div>
    </div>
  </section>

  <section id="titles" class="mechanics-section" aria-labelledby="titles-title">
    <header class="mechanics-heading">
      <QuestIcon name="scroll" size={34} />
      <div><h2 id="titles-title">{titles.title}</h2><p>{titles.summary}</p></div>
    </header>
    <div class="mechanics-panel title-preview">
      <div><h3>Cosmetic title</h3><p>Choose the title shown beside your character.</p><div class="title-badge-row">
        {featuredTitles.map((title: any) => titleBadges[title.id] && <span class="title-badge" style={badgeStyle(title.id)} role="img" aria-label={title.name}></span>)}
      </div></div>
      <div><h3>Passive title</h3><p>Activate one unlocked title for its gameplay bonuses. You can use a different title in each slot.</p></div>
    </div>
    <div class="mechanics-reference mechanic-list">
      {titles.sections.filter((section: any) => section.title !== 'Title catalogue').map((section: any) => <MechanicSection section={section} collapsible />)}
      <details class="title-catalogue">
        <summary>Title catalogue <span>· {fmt(titles.catalog.length)} titles</span></summary>
        <div class="table-wrap"><table>
          <thead><tr><th scope="col">Title</th><th scope="col">How to earn it</th><th scope="col">Passive bonuses</th></tr></thead>
          <tbody>{titles.catalog.map((title: any) => <tr>
            <td>{titleBadges[title.id] ? <span class="title-badge" style={badgeStyle(title.id)} role="img" aria-label={title.name}></span> : title.name}</td>
            <td>{title.description}</td>
            <td>{title.perks.length ? title.perks.map((perk: any) => perk.description).join(' · ') : 'Cosmetic only'}</td>
          </tr>)}</tbody>
        </table></div>
      </details>
    </div>
  </section>


</Layout>

<script src="../scripts/mechanics.js"></script>

<style>
  .character-navigation {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 32px;
  }
  .mechanics-nav { margin: 0; }
  .mechanics-nav a { gap: 9px; }
  .mechanics-section {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .mechanics-heading {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
  }
  .mechanics-heading h2 { margin: 0; }
  .mechanics-heading p { margin: 5px 0 0; color: var(--muted); }
  .level-calculator-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .level-calculator-heading label {
    font-size: 18px;
    font-weight: 600;
  }
  .level-calculator-heading output {
    padding: 3px 12px;
    background: var(--gold-surface);
    border: 1px solid var(--gold-border);
    border-radius: 5px;
    color: var(--gold-text);
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .level-calculator input[type="range"] {
    display: block;
    width: 100%;
    height: 30px;
    margin: 0;
    accent-color: var(--accent);
  }
  .level-extremes {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--subtle);
  }
  .progression-totals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0;
  }
  .progression-totals dt {
    color: var(--subtle);
    font-size: 13px;
  }
  .progression-totals dd {
    margin: 2px 0 0;
    font-size: clamp(16px, 1.6vw, 24px);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .ceiling-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
    gap: 10px 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .ceiling-list li {
    border-top: 2px solid var(--gold-border);
    padding: 6px 0;
    line-height: 1.4;
  }
  .ceiling-list li span {
    display: block;
    font-size: 13px;
    color: var(--subtle);
  }
  .ceiling-list li span:first-child {
    color: var(--text);
  }
  .ceiling-list strong {
    font-size: 17px;
  }
  .mechanics-reference.mechanic-list { margin-top: 12px; }
  .origin-controls {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }
  .origin-controls label {
    display: block;
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .origin-controls input,
  .origin-controls select {
    min-height: 44px;
    min-width: 0;
    width: 100%;
    padding: 7px 10px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--control-border);
    border-radius: 6px;
  }
  .origin-controls > div:first-child { flex: 1 1 220px; }
  .origin-controls > div:nth-child(2) { flex: 0 1 190px; }
  .origin-count { color: var(--subtle); font-size: 14px; padding: 10px 0 10px 4px; }
  .origin-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .origin-entry {
    min-width: 0;
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    scroll-margin-top: calc(var(--header-height) + 12px);
  }
  .origin-entry:target { border-color: var(--accent); }
  .origin-heading {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .origin-heading h3 { margin: 0; font-size: 16px; }
  .origin-entry img {
    flex-shrink: 0;
    image-rendering: pixelated;
    object-fit: contain;
  }
  .origin-ascended { margin-left: auto; }
  .origin-perks { margin: 8px 0; padding-inline-start: 20px; font-size: 14px; line-height: 1.45; }
  .origin-perks li { margin: 3px 0; }
  .origin-perks li::marker { color: var(--gold-text); }
  .origin-description { margin: 10px 0 0; color: var(--subtle); font-size: 14px; line-height: 1.45; }
  .title-badge-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .title-badge {
    display: block;
    max-width: 100%;
    height: 24px;
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }
  .title-catalogue {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
  }
  .title-catalogue summary { cursor: pointer; padding: 13px 16px; font-weight: 550; }
  .title-catalogue summary::marker { color: var(--gold-text); }
  .title-catalogue summary span { color: var(--subtle); font-weight: 400; }
  .title-catalogue .table-wrap { border-width: 1px 0 0; border-radius: 0 0 6px 6px; }
  .title-catalogue td:first-child { width: 22%; }
  .title-catalogue .title-badge { max-width: none; }
  @media (max-width: 1150px) {
    .origin-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .progression-totals dd { overflow-wrap: anywhere; }
  }
  @media (max-width: 690px) {
    .mechanics-section { margin-top: 36px; }
  }
  @media (max-width: 580px) {
    .origin-grid { grid-template-columns: minmax(0, 1fr); }
    .origin-controls > div:first-child { flex-basis: 100%; }
    .origin-controls > div:nth-child(2) { flex: 1; }
  }
</style>
