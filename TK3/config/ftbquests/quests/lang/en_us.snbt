  "quest.6E889267FD6C3269.title": "&f&lCrafting · profession&r",
  "quest.6E889267FD6C3269.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fUnderstand this part of your adventure.",
    "",
    "&fRepair efficiency, free-enchant chance and mining-equipment durability. Inspect the three branches and six focus options in your personal tree before committing points.",
    "",
    "&a&l✦ TIP&r",
    "&fCrafting profession nodes do not remove recipe ingredients or provide free mechanisms.",
    "",
    "&7Reading check · Mark this when you understand the guide.",
    "",
    "&7Optional branch · Supports your journey alongside the main campaign."
  ],
  "quest.6E889267FD6C3269.quest_subtitle": "&7FIELD GUIDE",
  "task.3DF56275D3D3463E.title": "Read and understand this guide",
  "quest.360F0A0299C21CFB.title": "&f&lCrafting · field assignment&r",
  "quest.360F0A0299C21CFB.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the project described below.",
    "",
    "&fPrepare a repair and equipment station, then maintain tools used by the workshop and explorers.",
    "",
    "&a&l✦ TIP&r",
    "&fCrafting profession nodes do not remove recipe ingredients or provide free mechanisms.",
    "",
    "&7Activity check · Mark this after completing the described project.",
    "",
