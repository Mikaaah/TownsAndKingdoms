  "quest.A4E248CF31726769.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fDecorative workbenches and palette blocks are building choices. They do not substitute for progression frames.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms.",
    "",
    "&7Optional branch · Supports your journey alongside the main campaign."
  ],
  "quest.A4E248CF31726769.quest_subtitle": "&7SIDE PATH",
  "quest.4D32AEA50E7A61D1.title": "&f&lCollect items early&r",
  "quest.4D32AEA50E7A61D1.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fA Hopper Upgrade pulls from and pushes to adjacent inventories. Use the Pickup Upgrade for loose dropped items; check its own range and filters.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms.",
    "",
    "&7Optional branch · Supports your journey alongside the main campaign."
