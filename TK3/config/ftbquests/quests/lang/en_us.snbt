  ],
  "quest.A9B0346B79583A4F.title": "&f&lWorkshop plan · Precision Machine&r",
  "quest.A9B0346B79583A4F.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fFollow the workshop plan and prepare this tier’s production line.",
    "",
    "&fFollow this chapter’s material and machine path. The previous milestone unlocks this tier. Optional quests introduce supporting systems; milestone rewards grant one unbreakable tool per player.",
    "",
    "&a&l✦ TIP&r",
    "&fSecure Blaze access and heated mixing first. Crushing Wheels now improve the geological processing routes."
  ],
  "quest.A9B0346B79583A4F.quest_subtitle": "&7CAMPAIGN",
