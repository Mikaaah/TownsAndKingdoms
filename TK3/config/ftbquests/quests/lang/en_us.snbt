  "quest.0BC7139100518ACF.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fMix bone meal, kelp and water into calcium powder. Compact prismarine shard, copper sheet and powder into two alloy; rods supply the Conduit Cage.",
    "",
    "&a&l✦ TIP&r",
    "&fSeparate water, crop supplies and sealing ingredients. Keep enough prismarine for the aquatic workshop."
  ],
  "quest.0BC7139100518ACF.quest_subtitle": "&7CAMPAIGN",
