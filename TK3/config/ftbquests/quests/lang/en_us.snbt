  "chapter.4AD45EFF90652F33.title": "&b07 ◆ &f&lIntegrated · Living Expeditions&r",
  "chapter.4AD45EFF90652F33.chapter_subtitle": [
    "Expedition Frame and connected production"
  ],
  "quest.47B7F7307CD559D6.title": "&f&lWorkshop plan · Expedition Frame&r",
  "quest.47B7F7307CD559D6.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fFollow the workshop plan and prepare this tier’s production line.",
    "",
    "&fFollow this chapter’s material and machine path. The previous milestone unlocks this tier. Optional quests introduce supporting systems; milestone rewards grant one unbreakable tool per player.",
    "",
    "&a&l✦ TIP&r",
    "&fHydrogen chloride comes from the chemical network. Test an expedition vessel close to home before a long flight."
  ],
  "quest.47B7F7307CD559D6.quest_subtitle": "&7CAMPAIGN",
  "task.B53800C2B1C57375.title": "Read this workshop plan",
  "quest.DC154F8C70241863.title": "&f&lRefine the radiance&r",
  "quest.DC154F8C70241863.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fInject one Shadow Steel with 100 units hydrogen chloride per finished operation, then press the Refined Radiance. This is gas processing in the Chemical Injection Chamber.",
    "",
    "&a&l✦ TIP&r",
    "&fHydrogen chloride comes from the chemical network. Test an expedition vessel close to home before a long flight."
  ],
  "quest.DC154F8C70241863.quest_subtitle": "&7CAMPAIGN",
  "quest.8BCF7F8F3766B09D.title": "&f&lExpedition Mechanism&r",
  "quest.8BCF7F8F3766B09D.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the Expedition Mechanism assembly in the exact listed order.",
    "",
    "&fUse the ordered sequenced assembly recipe. One loop guarantees one mechanism; the final Deployer holds farmersdelight:diamond_knife. Ordinary tools wear; the chapter reward version is unbreakable.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fStart with Reinforced Mechanism.",
    "&62. &fDeploy Manipulation Essence.",
    "&63. &fDeploy Radiance Sheet.",
    "&64. &fFinish under a Deployer holding Diamond Knife.",
    "",
    "&a&l✦ TIP&r",
    "&fOne loop guarantees one mechanism. Ordinary finishing tools wear; the chapter reward tool is unbreakable.",
    "",
    "&c&l! WATCH OUT&r",
    "&fSupply each step separately and keep unfinished mechanisms on their ordered assembly route."
  ],
  "quest.8BCF7F8F3766B09D.quest_subtitle": "&7CAMPAIGN",
