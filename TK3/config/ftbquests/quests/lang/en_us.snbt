  "quest.1998D959F28147AB.title": "&f&lChemical Machine&r",
  "quest.1998D959F28147AB.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fDeploy this tier’s mechanism onto its matching casing. Follow the machine’s JEI recipe or the stonecutter output menu for the next equipment choice.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fPut Steel Casing on the belt or depot.",
    "&62. &fDeploy Reinforced Mechanism onto it.",
    "&63. &fStonecut the frame into the machine you need.",
    "",
    "&a&l✦ TIP&r",
    "&fEach stonecut output consumes its own frame. Stock several frames for a complete workshop."
  ],
  "quest.1998D959F28147AB.quest_subtitle": "&7CAMPAIGN",
  "quest.8BA3822AB975EA8B.title": "&f&lControl the gas network&r",
  "quest.8BA3822AB975EA8B.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fChemical Machines build advanced chemical equipment. Evaporation produces brine; separating brine gives chlorine. Infuse hydrogen + chlorine into hydrogen chloride.",
    "",
    "&a&l✦ TIP&r",
    "&fFirst PRCs, separators and chemical buffers use Ender Machines; finish the native HDPE chain before expanding."
  ],
  "quest.8BA3822AB975EA8B.quest_subtitle": "&7CAMPAIGN",
  "quest.23EDF4E48269DD0E.title": "&f&lStore chemicals in ME&r",
  "quest.23EDF4E48269DD0E.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fCraft the chemical housing with Chemical Machines. Combine with an AE2 component; native preserving cell upgrades keep their stored chemicals.",
    "",
    "&a&l✦ TIP&r",
    "&fFirst PRCs, separators and chemical buffers use Ender Machines; finish the native HDPE chain before expanding."
  ],
  "quest.23EDF4E48269DD0E.quest_subtitle": "&7CAMPAIGN",
  "quest.D5FDACA2A14DE92D.title": "&f&lDefeat Lich&r",
  "quest.D5FDACA2A14DE92D.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fA player kill awards the reusable core. Keep it for imprinting; repeated kills add parallel production capacity.",
    "",
    "&a&l✦ TIP&r",
    "&fFirst PRCs, separators and chemical buffers use Ender Machines; finish the native HDPE chain before expanding."
  ],
  "quest.D5FDACA2A14DE92D.quest_subtitle": "&7CAMPAIGN",
  "quest.B507100C88BFAFB1.title": "&f&lKeep the Verdant Sigil&r",
  "quest.B507100C88BFAFB1.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fBoss cores are permanent catalysts. Retained deployment recipes leave the core in the Deployer.",
    "",
    "&a&l✦ TIP&r",
    "&fFirst PRCs, separators and chemical buffers use Ender Machines; finish the native HDPE chain before expanding.",
    "",
    "&c&l! WATCH OUT&r",
    "&fDo not route boss catalysts into void upgrades, disposal or general ingredient consumption.",
    "",
    "&7Optional branch · Supports your journey alongside the main campaign."
  ],
  "quest.B507100C88BFAFB1.quest_subtitle": "&7SIDE PATH",
  "quest.548A5B1D466FBE57.title": "&f&lRun the workshop continuously&r",
  "quest.548A5B1D466FBE57.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fBuild and test the setup described below.",
    "",
    "&fDemonstrate a complete material → mechanism → casing/frame → machine line. Set filters, buffers and output handling; confirm it runs without manual ingredient insertion.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fStock the raw-material buffers.",
    "&62. &fRun material → mechanism → casing/frame → machine.",
    "&63. &fTest repeated batches and output collection without hand-feeding.",
    "",
    "&a&l✦ TIP&r",
    "&fFirst PRCs, separators and chemical buffers use Ender Machines; finish the native HDPE chain before expanding.",
    "",
    "&7Activity check · Mark this after completing the described project."
  ],
  "quest.548A5B1D466FBE57.quest_subtitle": "&7CAMPAIGN",
  "task.C8A00DA5C1DB4AD2.title": "Confirm the working setup",
  "quest.DCEB2AF9B398CAEB.title": "&6&l◆ COMPLETE CHAPTER 6&r",
  "quest.DCEB2AF9B398CAEB.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete this chapter and claim your permanent workshop tool.",
    "",
    "&fClaim your unbreakable workshop tool. Completing this chapter unlocks the next tier for the team, including offline players when they next join.",
    "",
    "&a&l✦ TIP&r",
    "&fClaim your own reward manually. The tool is awarded once per player, even on a shared team."
  ],
  "quest.DCEB2AF9B398CAEB.quest_subtitle": "&7CAMPAIGN",
