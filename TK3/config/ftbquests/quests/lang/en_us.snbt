  "quest.F47CF308EDE8D9E1.title": "&f&lWorkshop plan · Hydraulic Machine&r",
  "quest.F47CF308EDE8D9E1.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fFollow the workshop plan and prepare this tier’s production line.",
    "",
    "&fFollow this chapter’s material and machine path. The previous milestone unlocks this tier. Optional quests introduce supporting systems; milestone rewards grant one unbreakable tool per player.",
    "",
    "&a&l✦ TIP&r",
    "&fSeparate water, crop supplies and sealing ingredients. Keep enough prismarine for the aquatic workshop."
  ],
  "quest.F47CF308EDE8D9E1.quest_subtitle": "&7CAMPAIGN",
  "task.56A5AB09CA65CAEC.title": "Read this workshop plan",
  "quest.EA2C4591FD4136DA.title": "&f&lCure the rubber&r",
  "quest.EA2C4591FD4136DA.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fCompact slime, dried kelp and 250 mB water. Mix one wheat, one kelp and 250 mB water into two slimeballs; supply the seals line.",
    "",
    "&a&l✦ TIP&r",
    "&fSeparate water, crop supplies and sealing ingredients. Keep enough prismarine for the aquatic workshop."
  ],
  "quest.EA2C4591FD4136DA.quest_subtitle": "&7CAMPAIGN",
