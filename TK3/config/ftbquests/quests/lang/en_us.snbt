  "chapter_group.377CA5D05B315B14.title": "&e◆ &f&lKINGDOM LIFE&r",
  "chapter.B67D7DBBCDDED52D.title": "&b01 ◆ &f&lAndesite · Roots of Industry&r",
  "chapter.B67D7DBBCDDED52D.chapter_subtitle": [
    "Kinetic Machine and connected production"
  ],
  "quest.5494F4CB9AF0890F.title": "&f&lWorkshop plan · Kinetic Machine&r",
  "quest.5494F4CB9AF0890F.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fFollow the workshop plan and prepare this tier’s production line.",
    "",
    "&fStart with the manual Kinetic Machine. It gives you the powered equipment needed to automate mechanisms. This first tier needs no previous milestone.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.5494F4CB9AF0890F.quest_subtitle": "&7CAMPAIGN",
  "task.2EF8A4D062254313.title": "Read this workshop plan",
  "quest.99B3475C4DF0D941.title": "&f&lAlgal Blend&r",
  "quest.99B3475C4DF0D941.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fKelp + clay makes two blend by hand, four in a mixer. Start a kelp farm beside your workshop.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.99B3475C4DF0D941.quest_subtitle": "&7CAMPAIGN",
  "quest.1D753529D556D6DB.title": "&f&lAndesite Alloy&r",
  "quest.1D753529D556D6DB.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fAndesite + blend makes two alloy by hand, four in a mixer. Original nugget alloy recipes are excluded.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.1D753529D556D6DB.quest_subtitle": "&7CAMPAIGN",
  "quest.1B588633702F98A6.title": "&f&lBuild the first frame&r",
  "quest.1B588633702F98A6.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fCraft 7 alloy + slab + Andesite Casing in AAA / ACA / ASA. Cut separate frames into power, press, mixer and Deployer. This route needs no mechanism.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.1B588633702F98A6.quest_subtitle": "&7CAMPAIGN",
  "quest.E04A18BDDDC24298.title": "&f&lTurn the wheel&r",
  "quest.E04A18BDDDC24298.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fStonecut one frame into three wheels. Connect shafts and gears; supply water.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.E04A18BDDDC24298.quest_subtitle": "&7CAMPAIGN",
  "quest.2D4C276157B50541.title": "&f&lAssemble the workshop&r",
  "quest.2D4C276157B50541.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fStonecut a manual frame into the Deployer. Add mixer, press and basin. Keep two deployers for alloys and a third holding the ordinary hammer.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms."
  ],
  "quest.2D4C276157B50541.quest_subtitle": "&7CAMPAIGN",
  "quest.5414921A0D3DEFE9.title": "&f&lKinetic Mechanism&r",
  "quest.5414921A0D3DEFE9.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the Kinetic Mechanism assembly in the exact listed order.",
    "",
    "&fUse the ordered sequenced assembly recipe. One loop guarantees one mechanism; the final Deployer holds betterend:iron_hammer. Ordinary tools wear; the chapter reward version is unbreakable.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fStart with any matching wooden slabs.",
    "&62. &fDeploy Andesite Alloy.",
    "&63. &fDeploy Andesite Alloy.",
    "&64. &fFinish under a Deployer holding Iron Hammer.",
    "",
    "&a&l✦ TIP&r",
    "&fOne loop guarantees one mechanism. Ordinary finishing tools wear; the chapter reward tool is unbreakable.",
    "",
    "&c&l! WATCH OUT&r",
    "&fSupply each step separately and keep unfinished mechanisms on their ordered assembly route."
  ],
  "quest.5414921A0D3DEFE9.quest_subtitle": "&7CAMPAIGN",
  "quest.2988658D06CB9D16.title": "&f&lKinetic Machine&r",
  "quest.2988658D06CB9D16.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fDeploy this tier’s mechanism onto its listed casing. Tier 1 also has the expensive manual startup route. Stonecutting consumes a frame; each output is a separate choice.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fPut Andesite Casing on the belt or depot.",
    "&62. &fDeploy Kinetic Mechanism onto it.",
    "&63. &fStonecut the frame into the machine you need.",
    "",
    "&a&l✦ TIP&r",
    "&fEach stonecut output consumes its own frame. Stock several frames for a complete workshop."
  ],
  "quest.2988658D06CB9D16.quest_subtitle": "&7CAMPAIGN",
  "quest.95CFF7A3CE498CEB.title": "&f&lRun the workshop continuously&r",
  "quest.95CFF7A3CE498CEB.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fBuild and test the setup described below.",
    "",
    "&fDemonstrate a complete material → mechanism → casing/frame → machine line. Set filters, buffers and output handling; confirm it runs without manual ingredient insertion.",
    "",
    "&6&l◇ HOW TO&r",
    "&61. &fStock the raw-material buffers.",
    "&62. &fRun material → mechanism → casing/frame → machine.",
    "&63. &fTest repeated batches and output collection without hand-feeding.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms.",
    "",
    "&7Activity check · Mark this after completing the described project."
  ],
  "quest.95CFF7A3CE498CEB.quest_subtitle": "&7CAMPAIGN",
  "task.D72F9E4FAE628D0A.title": "Confirm the working setup",
  "quest.B0A94968CD02DE8A.title": "&6&l◆ COMPLETE CHAPTER 1&r",
  "quest.B0A94968CD02DE8A.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete this chapter and claim your permanent workshop tool.",
    "",
    "&fClaim your unbreakable workshop tool. Completing this chapter unlocks the next tier for the team, including offline players when they next join.",
    "",
    "&a&l✦ TIP&r",
    "&fClaim your own reward manually. The tool is awarded once per player, even on a shared team."
  ],
  "quest.B0A94968CD02DE8A.quest_subtitle": "&7CAMPAIGN",
  "task.E967F29E5D7CDDF5.title": "Confirm the working setup",
  "quest.7E4C49B0B3CC4236.title": "&f&lFarmer’s Delight&r",
  "quest.7E4C49B0B3CC4236.quest_desc": [
    "&d&l◆ GOAL&r",
    "&fComplete the detected item or boss goal below.",
    "",
    "&fUse cutting and cooking for food. Feed wheat, kelp and bone meal to the industrial crop lines.",
    "",
    "&a&l✦ TIP&r",
    "&fKeep wheat, kelp and clay buffers near the first workshop. Build several manual frames before automating mechanisms.",
    "",
    "&7Optional branch · Supports your journey alongside the main campaign."
  ],
  "quest.7E4C49B0B3CC4236.quest_subtitle": "&7SIDE PATH",
